<form version="1.1" theme="dark">
  <label>Lookup Tables Dashboard</label>
  <!-- New welcome panel when no specific lookup is selected -->
  <!-- New summary dashboard for lookup categories -->
  <!-- REARRANGED: First show data quality metrics -->
  <!-- Then show lookup details -->
  <!-- Then show lookup contents -->
  <!-- Next show field summary -->
  <!-- FIXED: Top values distribution without using top_values parameter -->
  <!-- Then show YML metadata -->
  <!-- Finally show example usage -->
  <!-- Original rows below - Available Lookup Tables panel stays at the bottom -->
  <fieldset submitButton="false">
    <input type="time" token="timetoken" searchWhenChanged="true">
      <label>Time Range</label>
      <default>
        <earliest>0</earliest>
        <latest></latest>
      </default>
    </input>
    <input type="dropdown" token="lookup_category" searchWhenChanged="true">
      <label>Lookup Category</label>
      <choice value="*">All Categories</choice>
      <choice value="bad_*">Threat Indicators (bad_)</choice>
      <choice value="bsl_*">Baselines (bsl_)</choice>
      <choice value="com_*">Common References (com_)</choice>
      <choice value="sus_*">Suspicious Indicators (sus_)</choice>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
    <input type="dropdown" token="selected_lookup" searchWhenChanged="true">
      <label>Select Lookup Table</label>
      <choice value="*">All Lookup Tables</choice>
      <default>*</default>
      <search>
        <query>
          <![CDATA[| rest /servicesNS/-/BASELINE/data/lookup-table-files 
| search title="$lookup_category$" title="*.csv"
| table title]]>
        </query>
      </search>
      <fieldForValue>title</fieldForValue>
      <fieldForLabel>title</fieldForLabel>
      <initialValue>*</initialValue>
    </input>
  </fieldset>
  <row depends="$selected_lookup$=*">
    <panel>
      <html>
        <div style="text-align: center; padding: 20px; background-color: #1c1c1c; border-radius: 5px; margin: 10px;">
          <h2>BASELINE Lookup Tables Dashboard</h2>
          <p style="font-size: 16px;">Welcome to the Lookup Tables Dashboard. This dashboard allows you to explore and analyse the lookup tables in the BASELINE App.</p>
          <p style="font-size: 14px;">To view detailed information about a specific lookup table, please select it from the dropdown menu above.</p>
          <hr/>
          <p style="font-size: 14px;">The lookup tables are categorized as follows:</p>
          <ul style="text-align: left; display: inline-block;">
            <li>
              <strong>Threat Indicators (bad_):</strong> Known bad values, IOCs, and threat indicators</li>
            <li>
              <strong>Baselines (bsl_):</strong> Baseline values for comparison and whitelists</li>
            <li>
              <strong>Common References (com_):</strong> Common reference data and mappings</li>
            <li>
              <strong>Suspicious Indicators (sus_):</strong> Potentially suspicious patterns and indicators</li>
          </ul>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Example Usage in Searches</title>
      <html>
        <div style="padding: 10px; background-color: #272727; border-radius: 5px;">
          <h3>Basic Lookup Usage</h3>
          <pre style="background-color: #1c1c1c; padding: 10px;">index=* sourcetype=* | lookup $selected_lookup$ [field_name] AS [your_field] OUTPUT [result_field]</pre>
          
          <h3>Filtering with Lookup</h3>
          <pre style="background-color: #1c1c1c; padding: 10px;">index=* sourcetype=* | lookup $selected_lookup$ [field_name] AS [your_field] | where isnotnull([result_field])</pre>
          
          <h3>Enriching with Lookup</h3>
          <pre style="background-color: #1c1c1c; padding: 10px;">index=* sourcetype=* 
| lookup $selected_lookup$ [field_name] AS [your_field] OUTPUT *
| table _time, host, [your_field], [result_field1], [result_field2]</pre>
        </div>
      </html>
    </panel>
  </row>
  <row depends="$selected_lookup$=*">
    <panel>
      <title>Lookup Tables by Row Count</title>
      <chart>
        <search>
          <query>| rest /servicesNS/-/BASELINE/data/lookup-table-files 
| search title="bsl*.csv" title="$lookup_category$"
| head 20
| map maxsearches=50 search="| inputlookup \"$$title$$\" | stats count | eval lookup_table=\"$$title$$\""
| where isnotnull(count)
| rename lookup_table as "Lookup Table" count as "Row Count"
| sort - "Row Count"
| fields "Lookup Table", "Row Count"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.axisLabelsX.majorLabelStyle.overflowMode">ellipsisNone</option>
        <option name="charting.axisLabelsX.majorLabelStyle.rotation">-45</option>
        <option name="charting.axisTitleX.text">Lookup Tables</option>
        <option name="charting.axisTitleX.visibility">visible</option>
        <option name="charting.axisTitleY.text">Number of Rows</option>
        <option name="charting.axisTitleY.visibility">visible</option>
        <option name="charting.chart">column</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Available Lookup Tables</title>
        <search>
          <query>| rest /servicesNS/-/BASELINE/data/lookup-table-files 
| search title="$lookup_category$" title="bsl*.csv"
| table title author updated
| rename title as "Lookup Table" author as Owner updated as "Last Updated"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="drilldown">row</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <set token="selected_lookup">$row.Lookup Table$</set>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Contents of Selected Lookup Table: $selected_lookup$</title>
        <search>
          <query>
            <![CDATA[| inputlookup $selected_lookup$
| head 100]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <option name="count">10</option>
      </table>
    </panel>
    <panel>
      <chart>
        <title>Field Summary for: $selected_lookup$</title>
        <search>
          <query>| inputlookup $selected_lookup$
| fieldsummary 
| rename field as "Field Name" count as "Count" distinct_count as "Distinct Values" min as "Min Value" max as "Max Value" mean as "Average" range as "Range" stdev as "Std Deviation"
| table "Field Name" "Count" "Distinct Values"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
</form>