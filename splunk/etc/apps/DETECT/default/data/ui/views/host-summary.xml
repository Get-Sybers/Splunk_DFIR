<form version="1.1" theme="dark">
  <label>Host-Summary</label>
  <!-- Base search to populate tokens -->
  <search id="base_info_search" depends="$host_token$">
    <query>
      index=powershell Command.Module=GetBasicInformation ComputerName=$host_token$
      | stats values(Data.OSVersion) as OSVersions, values(IPAddress) as IPAddresses, count(IPAddress) as ip_count, count(Data.OSVersion) as os_count by ComputerName
      | head 1
    </query>
    <earliest>$timetoken.earliest$</earliest>
    <latest>$timetoken.latest$</latest>
    <done>
      <condition match="$job.resultCount$ &gt; 0">
        <condition match="$result.ip_count$ == 1">
          <set token="ip_token">$result.IPAddresses$</set>
        </condition>
        <condition match="$result.os_count$ == 1">
          <set token="OS_token">$result.OSVersions$</set>
        </condition>
        <set token="host_info_found">true</set>
      </condition>
    </done>
  </search>
  <fieldset submitButton="false">
    <input type="time" token="timetoken">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="host_token">
      <label>Host</label>
      <choice value="*">All</choice>
      <fieldForLabel>ComputerName</fieldForLabel>
      <fieldForValue>ComputerName</fieldForValue>
      <search>
        <query>index=powershell
|  stats count by ComputerName
| sort -ComputerName</query>
        <earliest>$timetoken.earliest$</earliest>
        <latest>$timetoken.latest$</latest>
      </search>
    </input>
    <input type="dropdown" token="ip_token" depends="$host_token$">
      <label>IP Address</label>
      <fieldForLabel>IPAddress</fieldForLabel>
      <fieldForValue>IPAddress</fieldForValue>
      <search>
        <query>index=powershell Command.Module=GetBasicInformation ComputerName=$host_token$
| stats count by IPAddress
| sort IPAddress</query>
        <earliest>$timetoken.earliest$</earliest>
        <latest>$timetoken.latest$</latest>
      </search>
    </input>
    <input type="dropdown" token="OS_token" depends="$host_token$,$ip_token$">
      <label>Operating System</label>
      <fieldForLabel>Data.OSVersion</fieldForLabel>
      <fieldForValue>Data.OSVersion</fieldForValue>
      <search>
        <query>index=powershell Command.Module=GetBasicInformation ComputerName=$host_token$ IPAddress=$ip_token$
| stats count by Data.OSVersion
| sort Data.OSVersion</query>
        <earliest>$timetoken.earliest$</earliest>
        <latest>$timetoken.latest$</latest>
      </search>
    </input>
  </fieldset>
  <row>
    <panel depends="$host_token$,$ip_token$">
      <html>
        <div style="text-align: center; padding: 10px;">
          <span>
            <strong>Viewing Host:</strong> $host_token$</span>
          <span style="margin-left: 20px;">
            <strong>IP Address:</strong> $ip_token$</span>
          <span style="margin-left: 20px;">
            <strong>OS Version:</strong> $OS_token$</span>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>IP Address with most outbound connections</title>
      <chart>
        <search>
          <query>index=powershell ComputerName=$host_token$ Command.Module=GetArpCache 
| stats count by "Data.IPAddress"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Users with most log ons</title>
      <chart>
        <search>
          <query>index=powershell ComputerName=$host_token$ "Data.LogFields.system_fields.EventID"=4624
| stats count by "Data.LogFields.event_fields.TargetUserName"
| sort -"Data.LogFields.event_fields.TargetUserName"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>User Logon Activity - 24hr Pattern (30-day baseline)</title>
      <chart>
        <search>
          <query>
            <![CDATA[
            index=powershell "Command.Module"=GetCustomLogs "Data.EventID"=4624 "Data.LogFields.system_fields.Computer"="$host_token$" 
            | eval hour_of_day=strftime(_time, "%H:%M") 
            | eval time_bucket=strftime(_time, "%H") + ":" + case(
                tonumber(strftime(_time, "%M")) < 30, "00", 
                1=1, "30"
            )
            | stats count by time_bucket, "Data.LogFields.event_fields.TargetUserName"
            | eval sort_key=tonumber(substr(time_bucket,1,2))*100 + if(match(time_bucket,"30"),30,0)
            | sort sort_key
            | xyseries time_bucket "Data.LogFields.event_fields.TargetUserName" count
            | fillnull value=0
          ]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.axisTitleX.text">Time of Day (24hr)</option>
        <option name="charting.axisTitleY.text">Average Logon Count</option>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">zero</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Network Shares Summary</title>
      <table>
        <search>
          <query><![CDATA[
            index=powershell "Command.Module"=GetNetworkShares ComputerName=$host_token$
            | eval ShareInfo="Data.Name" + " (" + "Data.Path" + ")"
            | eval Alert=if(match("Data.Name", "^(C\$|ADMIN\$)$"), "⚠️", "")
            | table Alert, ShareInfo, "Data.Status"
            | rename ShareInfo as "Share (Path)", "Data.Status" as "Status"
            ]]></query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
          </search>
          <option name="refresh.display">progressbar</option>
          <option name="drilldown">none</option>
          <option name="count">10</option>
        </table>
      </panel>
      <panel>
        <title>recent files by &amp;usertkoken$</title>
        <event>
          <search>
            <query>placehodler</query>
            <earliest>$timetoken.earliest$</earliest>
            <latest>$timetoken.latest$</latest>
          </search>
          <option name="list.drilldown">none</option>
        </event>
      </panel>
      <panel>
        <title>some other bad stuff</title>
        <event>
          <search>
            <query>placeholder</query>
            <earliest>$timetoken.earliest$</earliest>
            <latest>$timetoken.latest$</latest>
          </search>
          <option name="list.drilldown">none</option>
        </event>
      </panel>
  </row>
</form>