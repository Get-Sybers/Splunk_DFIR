<form version="1.1" theme="dark">
  <label>Log2Timeline Navigation Dashboard</label>
  <description>Navigate to various forensic artifact dashboards</description>
  <fieldset submitButton="false">
    <input type="time" token="field1">
      <label></label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <html>
        <h1>Splunk Log2Timeline Forensic Analysis</h1>
        <p>Select a dashboard to view specific forensic artifacts from log2timeline data</p>
        <div class="btn-group">
          <a class="btn btn-primary" href="run_dashboard">Run/RunOnce Keys</a>
          <a class="btn btn-primary" href="registry_dashboard">Registry Analysis</a>
          <a class="btn btn-primary" href="prefetch_dashboard">Prefetch Files</a>
          <a class="btn btn-primary" href="recyclebin_dashboard">Recycle Bin</a>
          <a class="btn btn-primary" href="setup_dashboard">Setup API</a>
          <a class="btn btn-primary" href="sccm_dashboard">SCCM Logs</a>
          <a class="btn btn-primary" href="pe_dashboard">PE Files</a>
          <a class="btn btn-primary" href="open_dashboard">Open/Recently Opened</a>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Timeline Overview</title>
      <chart>
        <search>
          <query>sourcetype="l2t:*" | timechart span=1h count by sourcetype</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.drilldown">all</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Artifact Type Distribution</title>
      <chart>
        <search>
          <query>sourcetype="l2t:*" | stats count by source_long</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
      </chart>
    </panel>
  </row>
</form>