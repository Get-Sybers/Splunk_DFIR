"""Unit tests for the Velociraptor SRUM / RECmd CAR maps (epic #86, Phase 2).

NO real Velociraptor SRUM/RECmd processed evidence exists in the data_store
(processed/velociraptor holds only a README), so every row here is SYNTHETIC —
shaped exactly like the vetted KQL views (kusto/schema/40-mitre.kql
CarFlow_Srum/CarProcess_Srum/CarRegistry_Recmd) expect the ingest wrap
{"Artefact","SourceFile","Record"} to look.
"""
import json

from get_sybers_dfir.car import normalize, sources

_SRC = "velociraptor/Collection-DESKTOP-9SL4Q3R-2024-05-01T10_00_00Z/results/Windows.Forensics.SRUM.json"
_SRC_FQDN = "velociraptor/Collection-host1.example.com-2024-05-01T10_00_00Z/results/Windows.Forensics.SRUM.json"

_NET = {
    "Artefact": "Windows.Forensics.SRUM.NetworkUsage",
    "SourceFile": _SRC,
    "Record": {
        "Id": 42, "Timestamp": "2024-04-30 17:00:00",
        "ExeInfo": r"\Device\HarddiskVolume2\Windows\System32\svchost.exe",
        "Sid": "S-1-5-21-1-2-3-1001", "UserName": "jake", "UserId": 7,
        "AppId": 12, "BytesSent": 1024, "BytesReceived": 0,
        "InterfaceType": 71, "ProfileName": "CorpWifi",
    },
}

_APP = {
    "Artefact": "Windows.Forensics.SRUM.AppResourceUsage",
    "SourceFile": _SRC,
    "Record": {
        "Id": 7, "Timestamp": "2024-04-30 18:00:00",
        "ExeInfo": r"\Device\HarddiskVolume2\Users\jake\Desktop\evil.exe",
        "Sid": "S-1-5-21-1-2-3-1001", "UserName": "jake",
        "ForegroundBytesRead": 4096, "ForegroundBytesWritten": 0,
        "BackgroundBytesRead": 0, "BackgroundBytesWritten": 0,
    },
}

_REG = {
    "Artefact": "Windows.Registry.RECmd",
    "SourceFile": "velociraptor/Collection-DESKTOP-9SL4Q3R-2024-05-01T10_00_00Z/results/Windows.Registry.RECmd.json",
    "Record": {
        "HivePath": r"C:\Users\jake\NTUSER.DAT",
        "HiveType": "NtUser", "Description": "Run key", "Category": "Autoruns",
        "KeyPath": r"Software\Microsoft\Windows\CurrentVersion\Run",
        "ValueName": "Updater", "ValueType": "RegSz",
        "ValueData": r"C:\Users\jake\AppData\evil.exe",
        "LastWriteTimestamp": "2024-04-29 12:34:56",
        "Deleted": False,
    },
}


# ---- SRUM Network Usage → flow ---------------------------------------------

def test_srum_network_usage_is_flow_message():
    ev = normalize.normalize("velociraptor_srum", _NET)
    assert ev["car_object"] == "flow" and ev["car_action"] == "message"
    assert ev["image_path"].endswith("svchost.exe")
    assert ev["user"] == "jake"
    assert ev["uid"] == "S-1-5-21-1-2-3-1001"       # SID's home is uid, not user
    assert ev["out_bytes"] == 1024                   # BytesSent = host → out
    assert ev["in_bytes"] == 0                       # 0 is a value, not a blank
    assert ev.get("start_time") is None              # accounting stamp ≠ flow start
    assert ev["timestamp"] == "2024-04-30 17:00:00"  # the record's own time
    assert ev["hostname"] == "DESKTOP-9SL4Q3R"       # host despite its dashes
    assert ev.get("fqdn") is None                    # not a dotted name
    assert ev["source_host"] == "DESKTOP-9SL4Q3R"
    assert ev["guid"] == f"flow-srum-{_SRC}:42"
    assert ev["_native"]["Sid"] == "S-1-5-21-1-2-3-1001"   # join key promoted
    assert ev["_native"]["UserId"] == 7                    # SRUM-internal FK: native only
    assert ev["_native"]["Record"]["BytesSent"] == 1024    # whole row kept queryable


def test_srum_fqdn_and_spaced_column_spellings():
    rec = {
        "Artefact": "Windows.Forensics.SRUM.NetworkUsage", "SourceFile": _SRC_FQDN,
        "Record": {"Id": 1, "Timestamp": "2024-04-30 17:00:00",
                   "ExeInfo": "", "AppId": "chrome.exe",     # "" falls through
                   "Bytes Sent": 10, "Bytes Received": 20},  # CSV-derived spelling
    }
    ev = normalize.normalize("velociraptor_srum", rec)
    assert ev["car_object"] == "flow"
    assert ev["out_bytes"] == 10 and ev["in_bytes"] == 20
    assert ev["image_path"] == "chrome.exe"          # coalesce past the empty ExeInfo
    assert ev["hostname"] == "host1"                 # first DNS label
    assert ev["fqdn"] == "host1.example.com"         # dotted → a real fqdn
    assert ev.get("user") is None                    # no username field: honest null


# ---- SRUM App Resource Usage → process --------------------------------------

def test_srum_app_resource_usage_is_process_create():
    ev = normalize.normalize("velociraptor_srum", _APP)
    assert ev["car_object"] == "process" and ev["car_action"] == "create"
    assert ev["exe"] == "evil.exe"                   # basename convention
    assert ev["image_path"].endswith(r"Desktop\evil.exe")
    assert ev["user"] == "jake" and ev["sid"] == "S-1-5-21-1-2-3-1001"
    assert ev.get("pid") is None and ev.get("command_line") is None  # SRUM has none
    assert ev["guid"] == f"process-srum-{_SRC}:7"
    assert ev["source_host"] == "DESKTOP-9SL4Q3R"


def test_srum_other_tables_and_foreign_rows_stay_raw():
    # EnergyUsage-shaped SRUM row: neither counter set → no canonical fit
    energy = {"Artefact": "Windows.Forensics.SRUM.EnergyUsage", "SourceFile": _SRC,
              "Record": {"Id": 3, "Timestamp": "2024-04-30 17:00:00",
                         "ChargeLevel": 80}}
    assert normalize.normalize("velociraptor_srum", energy) is None
    # a non-SRUM velociraptor row fed under the key drops (artefact guard)
    foreign = {"Artefact": "Windows.Sys.Users", "SourceFile": _SRC,
               "Record": {"BytesSent": 5}}
    assert normalize.normalize("velociraptor_srum", foreign) is None


# ---- RECmd batch → registry --------------------------------------------------

def test_recmd_value_row_is_value_edit():
    ev = normalize.normalize("velociraptor_recmd", _REG)
    assert ev["car_object"] == "registry"
    assert ev["car_action"] == "value_edit"          # authoritative, not "edit"
    assert ev["key"].endswith(r"CurrentVersion\Run")
    assert ev["value"] == "Updater" and ev["type"] == "RegSz"
    assert ev["data"].endswith("evil.exe")
    assert ev["hive"] == r"C:\Users\jake\NTUSER.DAT"
    assert ev["user"] == "jake"                      # definitive by hive path
    assert ev["timestamp"] == "2024-04-29 12:34:56"
    assert ev["hostname"] == "DESKTOP-9SL4Q3R" and ev.get("fqdn") is None
    assert ev["guid"] == ("registry-" r"C:\Users\jake\NTUSER.DAT" ":"
                          r"Software\Microsoft\Windows\CurrentVersion\Run"
                          ":Updater:2024-04-29 12:34:56")
    assert ev["_native"]["HiveType"] == "NtUser"
    assert ev["_native"]["Deleted"] is False


def test_recmd_key_row_is_key_edit_and_asserts_no_value():
    rec = {"Artefact": "Windows.Registry.RECmd", "SourceFile": _REG["SourceFile"],
           "Record": {"HivePath": r"C:\Windows\System32\config\SOFTWARE",
                      "KeyPath": r"Microsoft\Windows NT\CurrentVersion",
                      "LastWriteTimestamp": "2024-04-01 00:00:00"}}
    ev = normalize.normalize("velociraptor_recmd", rec)
    assert ev["car_action"] == "key_edit"
    assert ev.get("value") is None and ev.get("data") is None
    assert ev.get("user") is None                    # a system hive names no user
    assert ev["guid"].startswith("registry-C:")


def test_recmd_imagepath_is_content_not_actor():
    rec = {"Artefact": "Windows.Registry.Services", "SourceFile": _REG["SourceFile"],
           "Record": {"HivePath": r"C:\Windows\System32\config\SYSTEM",
                      "KeyPath": r"ControlSet001\Services\evilsvc",
                      "ValueName": "ImagePath", "ValueType": "RegExpandSz",
                      "ValueData": r"C:\evil.exe",
                      "ImagePath": r"C:\evil.exe",
                      "LastWriteTimestamp": "2024-04-01 00:00:00"}}
    ev = normalize.normalize("velociraptor_recmd", rec)
    # registry content about a binary, NOT the process that made the edit:
    assert ev.get("image_path") is None
    assert ev["_native"]["ImagePath"] == r"C:\evil.exe"
    assert ev.get("owning_pid") is None              # no PID emitted → no claim


def test_recmd_keyless_row_stays_raw():
    rec = {"Artefact": "Windows.Registry.RECmd", "SourceFile": _REG["SourceFile"],
           "Record": {"HivePath": r"C:\x", "ValueData": "orphan"}}
    assert normalize.normalize("velociraptor_recmd", rec) is None


# ---- through the real reader path (sources.iter_mapped) ----------------------

def test_iter_mapped_over_wrapped_jsonl(tmp_path):
    p = tmp_path / "srum.jsonl"
    # one of each SRUM table + one un-mappable energy row, as ingest wraps them
    energy = {"Artefact": "Windows.Forensics.SRUM.EnergyUsage",
              "SourceFile": _SRC, "Record": {"Id": 9, "ChargeLevel": 1}}
    p.write_text("\n".join(json.dumps(r) for r in (_NET, _APP, energy)))
    events = list(sources.iter_mapped("velociraptor_srum", str(p)))
    assert [e["car_object"] for e in events] == ["flow", "process"]
    assert all(e["source_host"] == "DESKTOP-9SL4Q3R" for e in events)
    assert all(e["source_artefact"] == "velociraptor_srum" for e in events)


def test_iter_mapped_default_host_fills_when_path_names_none(tmp_path):
    rec = dict(_NET, SourceFile="other/dir/srum.json")   # no velociraptor/ dir
    p = tmp_path / "srum2.jsonl"
    p.write_text(json.dumps(rec))
    (ev,) = sources.iter_mapped("velociraptor_srum", str(p), default_host="HOSTX")
    assert ev.get("hostname") is None                # not provable from the path
    assert ev["source_host"] == "HOSTX"              # caller-supplied scope fills
