// Database: host
//
// Applied with `.execute database script`, which is sequential but NOT
// transactional and performs no rollback on error. Every command below is
// therefore an idempotent form (.create-merge, .create-or-alter) so a
// re-applied schema converges instead of failing halfway.
//
// Ingestion mappings map by ORDINAL for CSV and by PATH for JSON, so Kusto
// column names do not have to match the source's. That matters: Plaso emits a
// column literally called "datetime", which collides with a Kusto type keyword.

//=============================================================================
// L2tJson — Plaso, JSON Lines (log2timeline.py -> .plaso -> psort.py -o json_line)
//
// Plaso emits one JSON object per event. Its fields VARY per parser: an fs:stat
// event carries inode/file_size, a pe_coff:file event carries imphash/sha256,
// a linux:utmp:event carries the terminal and address — a flat CSV forced all of
// that into 23 lowest-common-denominator columns and dropped the rest. Semi-
// structured is the honest representation, the same shape memory.VolatilityJson
// and host.VelociraptorJson use: a `dynamic` Record per event, accessed as
// Record.field (Record.data_type, Record.timestamp_desc, Record.display_name…).
//
// TWO ENRICHMENTS the raw psort output does NOT provide, added by
// process-log2timeline-Dynamic.sh before ingest and present on EVERY record:
//   Record.hostname  the host the image belongs to, read from the .plaso via
//                    pinfo.py (Plaso preprocessing resolves it from the registry
//                    ComputerName / /etc/hostname). psort's json_line omits it.
//   Record.volume    the source image/volume identifier, so an event's drive of
//                    origin is recoverable. psort's json_line omits it too.
// The output file is also named by hostname (from pinfo), not the image filename.
//
// Timestamp is LIFTED to a real datetime column. Plaso's json_line `timestamp`
// is an integer of MICROSECONDS since epoch; the ingest prepare hook converts it
// once (ingestion mappings cannot call unixtime_microseconds_todatetime), so the
// table is time-filterable without reaching into Record.
//
// SourceImage / Timestamp are per-file/per-record constants .ingest cannot
// inject, so ingest-kusto.sh's l2t_prepare hook wraps each line as
// {SourceImage, Timestamp, Record} — the same constant-injection pattern the
// Volatility/Velociraptor/Zeek loaders use.
//=============================================================================
.create-merge table L2tJson (
    SourceImage: string,
    Timestamp:   datetime,
    Record:      dynamic
)

.create-or-alter table L2tJson ingestion json mapping "L2tJsonMapping"
```[
  {"Column":"SourceImage", "Properties":{"Path":"$.SourceImage"}},
  {"Column":"Timestamp",   "Properties":{"Path":"$.Timestamp"}},
  {"Column":"Record",      "Properties":{"Path":"$.Record"}}
]```

//=============================================================================
// EvtxEcmdJson — EvtxECmd --json, one object per line
//
// Payload is the EventData XML fragment as a string. The CAR functions parse
// the fields they need out of it by Name attribute, exactly as the Splunk-era
// props.conf EXTRACT rules do.
//=============================================================================
.create-merge table EvtxEcmdJson (
    RecordNumber:  long,
    EventRecordId: long,
    TimeCreated:   datetime,
    EventId:       int,
    Level:         string,
    Provider:      string,
    Channel:       string,
    ProcessId:     int,
    ThreadId:      int,
    Computer:      string,
    ChunkNumber:   int,
    UserId:        string,
    MapDescription:string,
    UserName:      string,
    RemoteHost:    string,
    PayloadData1:  string,
    PayloadData2:  string,
    PayloadData3:  string,
    PayloadData4:  string,
    PayloadData5:  string,
    PayloadData6:  string,
    ExecutableInfo:string,
    HiddenRecord:  bool,
    SourceFile:    string,
    Payload:       string
)

.create-or-alter table EvtxEcmdJson ingestion json mapping "EvtxEcmdJsonMapping"
```[
  {"Column":"RecordNumber",  "Properties":{"Path":"$.RecordNumber"}},
  {"Column":"EventRecordId", "Properties":{"Path":"$.EventRecordId"}},
  {"Column":"TimeCreated",   "Properties":{"Path":"$.TimeCreated"}},
  {"Column":"EventId",       "Properties":{"Path":"$.EventId"}},
  {"Column":"Level",         "Properties":{"Path":"$.Level"}},
  {"Column":"Provider",      "Properties":{"Path":"$.Provider"}},
  {"Column":"Channel",       "Properties":{"Path":"$.Channel"}},
  {"Column":"ProcessId",     "Properties":{"Path":"$.ProcessId"}},
  {"Column":"ThreadId",      "Properties":{"Path":"$.ThreadId"}},
  {"Column":"Computer",      "Properties":{"Path":"$.Computer"}},
  {"Column":"ChunkNumber",   "Properties":{"Path":"$.ChunkNumber"}},
  {"Column":"UserId",        "Properties":{"Path":"$.UserId"}},
  {"Column":"MapDescription","Properties":{"Path":"$.MapDescription"}},
  {"Column":"UserName",      "Properties":{"Path":"$.UserName"}},
  {"Column":"RemoteHost",    "Properties":{"Path":"$.RemoteHost"}},
  {"Column":"PayloadData1",  "Properties":{"Path":"$.PayloadData1"}},
  {"Column":"PayloadData2",  "Properties":{"Path":"$.PayloadData2"}},
  {"Column":"PayloadData3",  "Properties":{"Path":"$.PayloadData3"}},
  {"Column":"PayloadData4",  "Properties":{"Path":"$.PayloadData4"}},
  {"Column":"PayloadData5",  "Properties":{"Path":"$.PayloadData5"}},
  {"Column":"PayloadData6",  "Properties":{"Path":"$.PayloadData6"}},
  {"Column":"ExecutableInfo","Properties":{"Path":"$.ExecutableInfo"}},
  {"Column":"HiddenRecord",  "Properties":{"Path":"$.HiddenRecord"}},
  {"Column":"SourceFile",    "Properties":{"Path":"$.SourceFile"}},
  {"Column":"Payload",       "Properties":{"Path":"$.Payload"}}
]```

//=============================================================================
// Velociraptor — semi-structured.
//
// Deliberately NOT given typed columns: Velociraptor's JSON varies per VQL
// artefact, and the planned offline collectors run Eric Zimmerman's tools,
// whose output is per-artefact with a different shape each time. Kusto
// handles this natively with a dynamic column — the honest representation,
// better than inventing a lowest-common-denominator schema that silently
// drops columns. Access is Record.FieldName in KQL.
//
// Artefact and SourceFile are per-file constants .ingest cannot inject, so
// ingest-kusto.sh's velociraptor_prepare hook wraps each collected record as
// {Artefact, SourceFile, Record} (Artefact from the filename, SourceFile from
// the path) and the mapping below reads all three — the same shape the
// Volatility loader uses. Artefact is what CarRegistry() filters on.
//
// (A KapeJson twin of this table existed until the KAPE path was removed in
// favour of Velociraptor offline collectors running the same EZ Tools. One
// lesson from it survives: a CSV ingestion mapping maps ordinals to columns
// and CANNOT build a `dynamic` object — so if the collectors emit EZ-tool
// CSV rather than JSON, the answer is typed per-artefact tables or a
// JSON-conversion step, never a dynamic-column CSV table. The wrapper keeps
// everything JSON, so this stays a dynamic-column table.)
//=============================================================================

.create-merge table VelociraptorJson (
    Artefact:   string,
    SourceFile: string,
    Record:     dynamic
)

.create-or-alter table VelociraptorJson ingestion json mapping "VelociraptorJsonMapping"
```[
  {"Column":"Artefact",   "Properties":{"Path":"$.Artefact"}},
  {"Column":"SourceFile", "Properties":{"Path":"$.SourceFile"}},
  {"Column":"Record",     "Properties":{"Path":"$.Record"}}
]```

.create-or-alter function
with (docstring = "Distinct Velociraptor artefacts present, with row counts", folder = "Views")
VelociraptorArtefacts() {
    VelociraptorJson
    | summarize Rows = count() by Artefact
    | order by Rows desc
}

//=============================================================================
// Convenience views.
//
// L2t events carry a timestamp_desc saying WHICH timestamp the event represents.
// Filtering to creation events is the common case and easy to get wrong.
//=============================================================================
.create-or-alter function
with (docstring = "Plaso events whose timestamp is a creation time", folder = "Views")
L2tCreations() {
    L2tJson
    | where tostring(Record.timestamp_desc) matches regex @"(?i)creation|crtime|birth"
}

// The common Plaso fields surfaced as named columns out of the dynamic Record,
// so downstream queries and the CAR functions are not littered with tostring().
// Everything else stays in Record (Record.imphash, Record.inode, …).
.create-or-alter function
with (docstring = "Plaso events with the common fields projected out of Record", folder = "Views")
L2tEvents() {
    L2tJson
    | extend
        DataType      = tostring(Record.data_type),
        TimestampDesc = tostring(Record.timestamp_desc),
        DisplayName   = tostring(Record.display_name),
        Message       = tostring(Record.message),
        FileName       = tostring(Record.filename),
        Parser        = tostring(Record.parser),
        Hostname      = tostring(Record.hostname),
        Volume        = tostring(Record.volume)
}

.create-or-alter function
with (docstring = "Windows Security logon events (4624/4625/4634/4647/4648/4778/4779)", folder = "Views")
WinLogonEvents() {
    EvtxEcmdJson
    | where EventId in (4624, 4625, 4634, 4647, 4648, 4778, 4779)
}
