// Database: mitre — the MITRE CAR data model in KQL
//
// The MITRE CAR model as KQL functions (it replaced the retired Splunk-era
// MITRE_CAR_App). Same object model,
// same coverage, same deliberate gaps — expressed as functions rather than as
// a data model with eventtypes and tags.
//
// WHY FUNCTIONS AND NOT UPDATE POLICIES
//
// An update policy writes a transformed copy into a second table on ingestion,
// and requires that "the update policy function schema and the target table
// schema must match in their column types, and order". For CAR that is the
// wrong shape: the nine objects are views over the same rows — a 4688 event is
// simultaneously an EvtxEcmdJson row and a car_process row. Materialising each
// object would double storage, force exact schema lockstep across every field,
// and make each mapping fix an ingestion-time change rather than a query-time
// one. Functions cost nothing to iterate on and match how the Splunk era
// already works: the data model is a view, not a copy.
//
// CROSS-DATABASE ACCESS
//
// Source tables live in the host / network / memory databases, so these use
// database("<name>").<Table>. That is why the databases are separate at all —
// they mirror the data domains, as intended.
//
// COVERAGE — 9 of 9 objects
//
//   CarFlow         Zeek conn + Sysmon 3 (network connect)
//   CarUserSession  EvtxECmd 4624/4625/4634/4647/4648/4778/4779 (Windows)
//                   + Plaso UTMP-session rows (Linux wtmp/utmp) + auditd PAM
//   CarProcess      EvtxECmd 4688/4689 + Sysmon 1/5, Plaso execution
//                   artefacts, Linux cron
//   CarService      EvtxECmd 7045/4697 (Windows) + Linux systemd (auditd)
//   CarFile         Plaso filesystem rows + Sysmon 11/23 (create/delete)
//   CarRegistry     Velociraptor registry artefacts (EZ Tools / RECmd)
//                   + Sysmon 12/13/14 (key/value add, set, rename)
//   CarDriver       Sysmon 6 (driver loaded)
//   CarModule       Sysmon 7 (image loaded)
//   CarThread       Sysmon 8 (CreateRemoteThread)
//
//   registry lost its only source when the KAPE path was removed; the
//   replacement — Velociraptor offline collectors running the EZ Tools (RECmd /
//   Registry Explorer) — is wired through host.VelociraptorJson and read by
//   CarRegistry(). Same Zimmerman field names the old KapeJson mapping used.
//
//   driver, module, thread — SOURCED via Sysmon. Nothing *dead-box* produces
//   driver loads, image loads or thread creation, which is why they were empty
//   for so long; Sysmon (Microsoft-Windows-Sysmon/Operational, events 6/7/8) is
//   the endpoint telemetry that does, and it lands in host.EvtxEcmdJson through
//   the same EvtxECmd path as the Windows Security log. See the SYSMON note
//   below for why the PID handling differs from the Security channel.
//
// NULLS ARE PRESERVED. Where a source cannot supply a CAR field it stays null
// rather than being defaulted. A visible gap is worth more than an object that
// looks fully populated.
//
// SYSMON — a second Windows source in the SAME table.
//
// Sysmon writes to Microsoft-Windows-Sysmon/Operational, which EvtxECmd parses
// into host.EvtxEcmdJson exactly like the Security log — so Sysmon rows are told
// apart by Provider ("Microsoft-Windows-Sysmon"), not by table. The CAR
// functions below filter Sysmon branches with `Provider matches regex sysmon`
// AND the Sysmon EventId, so a stray EventId 6/7/8 from another provider (those
// numbers are reused across channels) can never leak into a Sysmon object.
//
// PID ENCODING DIFFERS. The Security channel writes ProcessId as a hex string
// ("0x1a4"); Sysmon writes it as a DECIMAL string ("420"). So Sysmon branches
// use tolong() directly and do NOT carry a pid_hex — the hex dance only the
// Security 4688 path needs. Getting this wrong would silently misparse every
// Sysmon PID, so it is called out at each Sysmon branch.

//=============================================================================
// Helper — pull a value out of an EvtxECmd Payload XML fragment by Name.
//
// EvtxECmd puts EventData in Payload as <Data Name="X">value</Data>, and its
// PayloadData1..6 summary fields vary by map, so they are not dependable for a
// specific value. Same approach as the Splunk-era EXTRACT rules.
//=============================================================================
.create-or-alter function
with (docstring = "Extract <Data Name='key'> from an EvtxECmd Payload fragment", folder = "Helpers")
EvtxPayload(payload:string, key:string) {
    extract(strcat(@'<Data Name="', key, @'">([^<]*)</Data>'), 1, payload)
}

//=============================================================================
// CarFlow — network connections
//
// Zeek conn.log is already CAR-shaped, so this is mostly a projection.
// EndTime is derived: conn.log has ts and duration, not an end timestamp.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'flow' object (Zeek conn + Sysmon network connect)", folder = "CAR")
CarFlow() {
    let FromZeek =
        database("network").ZeekTyped()
        | extend
            action        = case(ConnState == "SF",   "end",
                                 ConnState == "S0",   "start",
                                 ConnState == "REJ",  "end",
                                 ConnState in ("RSTO", "RSTR"), "end",
                                 isnotempty(ConnState), "message",
                                 ""),
            src_ip        = SrcIp,
            src_port      = SrcPort,
            dest_ip       = DestIp,
            dest_port     = DestPort,
            protocol      = Proto,
            start_time    = Ts,
            end_time      = iff(isnotnull(DurationSec), datetime_add('second', toint(DurationSec), Ts), datetime(null)),
            packet_count  = coalesce(OrigPktsN, 0) + coalesce(RespPktsN, 0),
            hostname      = ""
        | project Timestamp = Ts, action, src_ip, src_port, dest_ip, dest_port,
                  protocol, start_time, end_time, packet_count, hostname, Uid;
    // Sysmon 3 (NetworkConnect) records a single connection AS IT IS MADE, with
    // no duration, byte or packet counts — so end_time/packet_count are null,
    // unlike Zeek conn. action is "start": the event marks initiation, not
    // completion. Uid is empty (Sysmon has no Zeek connection uid).
    let FromSysmon =
        database("host").EvtxEcmdJson
        | where Provider matches regex @"(?i)sysmon" and EventId == 3
        | extend
            src_ip       = EvtxPayload(Payload, "SourceIp"),
            src_port     = toint(EvtxPayload(Payload, "SourcePort")),
            dest_ip      = EvtxPayload(Payload, "DestinationIp"),
            dest_port    = toint(EvtxPayload(Payload, "DestinationPort")),
            protocol     = EvtxPayload(Payload, "Protocol")
        | project
            Timestamp    = TimeCreated,
            action       = "start",
            src_ip, src_port, dest_ip, dest_port, protocol,
            start_time   = TimeCreated,
            end_time     = datetime(null),
            packet_count = long(0),
            hostname     = Computer,
            Uid          = "";
    union FromZeek, FromSysmon
}

//=============================================================================
// CarUserSession — logon / logoff
//
// LogonType is the Windows logon type: 2 interactive, 3 network, 7 unlock,
// 10 RemoteInteractive (RDP). 4624's IpAddress is "-" for a local logon rather
// than absent, so those are nulled out instead of being stored as "-".
//=============================================================================
// Two sources, unioned — the object is cross-platform:
//   Windows  EvtxECmd 4624/4625/4634/4647/4648/4778/4779
//   Linux    Plaso UTMP-session rows (wtmp/utmp). Status USER_PROCESS is a
//            login, DEAD_PROCESS a logout, BOOT_TIME a boot. The fields are
//            parsed out of Plaso's rendered message with extract(), the same
//            way the EvtxECmd payload fields are — Plaso does not give them
//            typed columns. EventId/LogonType are null for Linux (they are
//            Windows concepts), which is the honest shape rather than a faked 0.
.create-or-alter function
with (docstring = "MITRE CAR 'user_session' object (Windows logons + Linux utmp)", folder = "CAR")
CarUserSession() {
    let FromEvtx =
        database("host").EvtxEcmdJson
        | where EventId in (4624, 4625, 4634, 4647, 4648, 4778, 4779)
        | extend
            TargetUserName = EvtxPayload(Payload, "TargetUserName"),
            TargetLogonId  = EvtxPayload(Payload, "TargetLogonId"),
            SubjectUserSid = EvtxPayload(Payload, "SubjectUserSid"),
            LogonType      = toint(EvtxPayload(Payload, "LogonType")),
            IpAddress      = EvtxPayload(Payload, "IpAddress"),
            IpPort         = EvtxPayload(Payload, "IpPort"),
            Workstation    = EvtxPayload(Payload, "WorkstationName")
        | extend
            action = case(EventId in (4634, 4647), "logout",
                          EventId == 4778, "reconnect",
                          EventId == 4779, "remote",
                          EventId == 4624 and LogonType == 10, "rdp",
                          EventId == 4624 and LogonType == 7,  "unlock",
                          EventId == 4624 and LogonType == 2,  "interactive",
                          EventId == 4624 and LogonType == 3,  "remote",
                          EventId in (4624, 4625), "login",
                          ""),
            user         = iff(isempty(TargetUserName), UserName, TargetUserName),
            sid          = iff(isempty(UserId), SubjectUserSid, UserId),
            logon_id     = TargetLogonId,
            hostname     = Computer,
            fqdn         = Computer,
            src_ip       = iff(IpAddress in ("-", "::1", "127.0.0.1", ""), "", IpAddress),
            src_port     = iff(IpPort in ("-", "0", ""), int(null), toint(IpPort)),
            src_hostname = iff(Workstation == "-", "", Workstation),
            platform     = "windows"
        | project Timestamp = TimeCreated, action, user, sid, logon_id, hostname,
                  fqdn, src_ip, src_port, src_hostname, EventId, LogonType,
                  platform, SourceFile;
    let FromUtmp =
        database("host").L2tCsv
        | where SourceLong == "UTMP session"
        | extend
            status = extract(@"Status:\s*(\w+)", 1, Message),
            ip     = extract(@"IP Address:\s*(\S+)", 1, Message)
        | extend
            action       = case(status == "USER_PROCESS", "login",
                                status == "DEAD_PROCESS",  "logout",
                                status == "LOGIN_PROCESS", "login",
                                status == "BOOT_TIME",     "boot",
                                ""),
            user         = extract(@"User:\s*(\S+)", 1, Message),
            sid          = "",
            logon_id     = "",
            hostname     = Hostname,
            fqdn         = "",
            src_ip       = iff(ip in ("0.0.0.0", "", "::1", "127.0.0.1"), "", ip),
            src_port     = int(null),
            src_hostname = extract(@"Terminal:\s*(\S+)", 1, Message),
            EventId      = int(null),
            LogonType    = int(null),
            platform     = "linux"
        | project Timestamp, action, user, sid, logon_id, hostname, fqdn,
                  src_ip, src_port, src_hostname, EventId, LogonType, platform,
                  SourceFile = DisplayName;
    // Linux auditd PAM events — richer than utmp (they carry acct, addr,
    // hostname and the res=success/failed outcome). USER_START is a session
    // open, USER_END a close. utmp and auditd are INDEPENDENT evidence for the
    // same sessions, so both appear, distinguished by SourceFile — the same way
    // CarProcess unions EvtxECmd and Plaso for one execution.
    let FromLinuxAudit =
        database("host").L2tCsv
        | where SourceLong == "Audit Log"
              and Message matches regex @"audit_type:\s*(USER_START|USER_END|USER_LOGIN)"
        | extend
            atype = extract(@"audit_type:\s*(\w+)", 1, Message),
            acct  = extract(@'acct=""?([^""\s]+)', 1, Message),
            addr  = extract(@"addr=(\S+)", 1, Message),
            hn    = extract(@"hostname=(\S+)", 1, Message),
            ses   = extract(@"\bses=(\d+)", 1, Message)
        | extend
            action       = case(atype == "USER_START", "login",
                                atype == "USER_END",   "logout",
                                atype == "USER_LOGIN", "login",
                                ""),
            user         = acct,
            sid          = "",
            logon_id     = ses,
            hostname     = Hostname,
            fqdn         = "",
            src_ip       = iff(addr in ("?", "", "0.0.0.0", "::1", "127.0.0.1"), "", addr),
            src_port     = int(null),
            src_hostname = iff(hn in ("?", ""), "", hn),
            EventId      = int(null),
            LogonType    = int(null),
            platform     = "linux"
        | project Timestamp, action, user, sid, logon_id, hostname, fqdn,
                  src_ip, src_port, src_hostname, EventId, LogonType, platform,
                  SourceFile = DisplayName;
    union FromEvtx, FromUtmp, FromLinuxAudit
}

//=============================================================================
// CarProcess — process creation / termination
//
// Two sources with genuinely different fidelity, unioned:
//
//   EvtxECmd 4688/4689  full: pid, ppid, parent, command line
//   Plaso execution     Prefetch/Amcache/AppCompatCache — exe only
//
// The artefact sources record THAT a binary ran, not the process tree that ran
// it, so pid/ppid/parent_exe/command_line are null for them. That is the
// honest shape of dead-box process data, and it is why the project's example
// search returns a command line only for 4688 rows.
//
// PIDs: Windows writes NewProcessId and EventData's ProcessId as hex strings
// ("0x1a4"). KQL has no base-16 string parser, and toint()/tolong() parse
// decimal — so toint("1a4") is null and toint("1234") is 1234 when the true
// value is 4660. Both the raw hex and a best-effort numeric form are exposed:
// pid_hex is always correct, pid is what CAR asks for.
//
// ✅ VERIFIED against the live emulator (issue #14, item 6): tolong() DOES
//    accept a "0x"-prefixed string at run time, not just a 0x integer literal —
//    tolong("0x1a4") = 420, tolong("0x1234") = 4660, and pid=420 on the
//    ingested 4688 row. Note tolong("1a4") without the prefix = null, so pid_hex
//    stays the always-correct raw form; EvtxECmd emits the "0x" form, so pid is
//    populated. See docs/Runtime-Validation.md.
//
// ppid comes from EventData's ProcessId (the creating process), NOT from the
// table's top-level ProcessId column — that is the Execution ProcessID of
// whatever WROTE the record, which for Security-channel events is the same
// value on every row and would give every process the same bogus parent.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'process' object", folder = "CAR")
CarProcess() {
    let FromEvtx =
        database("host").EvtxEcmdJson
        | where EventId in (4688, 4689)
        | extend
            NewProcessName    = EvtxPayload(Payload, "NewProcessName"),
            NewProcessId      = EvtxPayload(Payload, "NewProcessId"),
            CreatorProcessId  = EvtxPayload(Payload, "ProcessId"),
            ParentProcessName = EvtxPayload(Payload, "ParentProcessName"),
            CommandLine       = EvtxPayload(Payload, "CommandLine"),
            SubjectUserName   = EvtxPayload(Payload, "SubjectUserName")
        | extend
            Timestamp         = TimeCreated,
            action            = iff(EventId == 4688, "create", "terminate"),
            exe               = NewProcessName,
            image_path        = NewProcessName,
            parent_exe        = ParentProcessName,
            parent_image_path = ParentProcessName,
            command_line      = CommandLine,
            pid_hex           = NewProcessId,
            ppid_hex          = CreatorProcessId,
            pid               = tolong(NewProcessId),
            ppid              = tolong(CreatorProcessId),
            user              = iff(isempty(SubjectUserName), UserName, SubjectUserName),
            hostname          = Computer,
            Origin            = "evtx:4688"
        | project Timestamp, action, exe, image_path, parent_exe,
                  parent_image_path, command_line, pid, ppid, pid_hex, ppid_hex,
                  user, hostname, Origin, SourceFile;
    let FromPlaso =
        database("host").L2tCsv
        | where SourceLong matches regex @"(?i)prefetch|amcache|appcompat"
        | extend
            Timestamp         = Timestamp,
            action            = "create",
            exe               = FileName,
            image_path        = DisplayName,
            parent_exe        = "",
            parent_image_path = "",
            command_line      = "",
            pid               = long(null),
            ppid              = long(null),
            pid_hex           = "",
            ppid_hex          = "",
            user              = UserName,
            hostname          = Hostname,
            Origin            = strcat("plaso:", SourceLong)
        | project Timestamp, action, exe, image_path, parent_exe,
                  parent_image_path, command_line, pid, ppid, pid_hex, ppid_hex,
                  user, hostname, Origin, SourceFile = DisplayName;
    // Linux: cron command execution. syslog CROND lines record THAT a command
    // ran with its command line and the crond worker's pid — but not ppid or a
    // parent image, the same shape as the Plaso execution artefacts above.
    // (This host's auditd had no execve rule, so there are no SYSCALL execve
    // records; cron is the process-execution evidence that IS present. A host
    // auditing execve would add a richer branch here with pid/ppid/exe.)
    let FromLinuxCron =
        database("host").L2tCsv
        | where SourceLong == "Log File" and Message matches regex @"CMD \("
        | extend
            command_line      = extract(@"CMD \((.*)\)\s*$", 1, Message),
            cron_user         = extract(@"\(([\w.-]+)\) CMD", 1, Message),
            cron_pid          = extract(@"pid:\s*(\d+)", 1, Message)
        | extend
            action            = "create",
            exe               = extract(@"^(\S+)", 1, command_line),
            image_path        = extract(@"^(\S+)", 1, command_line),
            parent_exe        = "",
            parent_image_path = "",
            pid               = tolong(cron_pid),
            ppid              = long(null),
            pid_hex           = "",
            ppid_hex          = "",
            user              = cron_user,
            hostname          = Hostname,
            Origin            = "linux:cron"
        | project Timestamp, action, exe, image_path, parent_exe,
                  parent_image_path, command_line, pid, ppid, pid_hex, ppid_hex,
                  user, hostname, Origin, SourceFile = DisplayName;
    // Sysmon 1 (ProcessCreate) / 5 (ProcessTerminate) — the richest process
    // source of the lot: full pid, ppid, parent image and command line, all in
    // one event. Sysmon writes ProcessId/ParentProcessId as DECIMAL strings
    // (not the hex the Security channel uses), so tolong() is applied directly
    // and pid_hex/ppid_hex are empty — the hex form is meaningless here. Event 5
    // carries only Image + ProcessId, so ppid/parent/command_line are null on a
    // terminate, which is the honest shape.
    let FromSysmon =
        database("host").EvtxEcmdJson
        | where Provider matches regex @"(?i)sysmon" and EventId in (1, 5)
        | extend
            SysImage        = EvtxPayload(Payload, "Image"),
            SysCmdLine      = EvtxPayload(Payload, "CommandLine"),
            SysPid          = EvtxPayload(Payload, "ProcessId"),
            SysPpid         = EvtxPayload(Payload, "ParentProcessId"),
            SysParentImage  = EvtxPayload(Payload, "ParentImage"),
            SysUser         = EvtxPayload(Payload, "User")
        | project
            Timestamp         = TimeCreated,
            action            = iff(EventId == 1, "create", "terminate"),
            exe               = SysImage,
            image_path        = SysImage,
            parent_exe        = SysParentImage,
            parent_image_path = SysParentImage,
            command_line      = SysCmdLine,
            pid               = tolong(SysPid),
            ppid              = tolong(SysPpid),
            pid_hex           = "",
            ppid_hex          = "",
            user              = SysUser,
            hostname          = Computer,
            Origin            = strcat("sysmon:", tostring(EventId)),
            SourceFile;
    union FromEvtx, FromPlaso, FromLinuxCron, FromSysmon
}

//=============================================================================
// CarService — service installation
//=============================================================================
// Two sources, unioned — cross-platform:
//   Windows  EvtxECmd 7045 (service installed) / 4697 (service installed, Security)
//   Linux    Plaso Audit-Log rows for systemd SERVICE_START/SERVICE_STOP. The
//            unit name and the systemd exe are parsed out of the audit message.
.create-or-alter function
with (docstring = "MITRE CAR 'service' object (Windows 7045/4697 + Linux systemd)", folder = "CAR")
CarService() {
    let FromEvtx =
        database("host").EvtxEcmdJson
        | where EventId in (7045, 4697)
        | extend
            name        = EvtxPayload(Payload, "ServiceName"),
            module_path = EvtxPayload(Payload, "ImagePath"),
            user        = UserName,
            hostname    = Computer,
            action      = "create",
            platform    = "windows"
        | project Timestamp = TimeCreated, action, name, module_path, user,
                  hostname, EventId, platform, SourceFile;
    let FromLinux =
        database("host").L2tCsv
        | where SourceLong == "Audit Log"
              and Message matches regex @"audit_type:\s*SERVICE_(START|STOP)"
        | extend
            atype = extract(@"audit_type:\s*SERVICE_(\w+)", 1, Message),
            name  = extract(@"unit=(\S+)", 1, Message),
            exe   = extract(@'exe=""?([^""\s]+)', 1, Message)
        | extend
            action      = iff(atype == "START", "create", "stop"),
            module_path = exe,
            user        = UserName,
            hostname    = Hostname,
            platform    = "linux"
        | project Timestamp, action, name, module_path, user, hostname,
                  EventId = int(null), platform, SourceFile = DisplayName;
    union FromEvtx, FromLinux
}

//=============================================================================
// CarFile — filesystem activity
//
// Plaso's timestamp_desc says WHICH timestamp a row represents, which is what
// makes the CAR action derivable at all.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'file' object", folder = "CAR")
CarFile() {
    let FromPlaso =
        database("host").L2tCsv
        | where SourceLong matches regex @"(?i)\bfs\b|ntfs|file"
        | extend
            // MACB -> CAR action. The modify branch matches "modification"
            // broadly, not just "content modification": against real Plaso
            // output an NTFS image emits THREE modification descriptions —
            // "Content Modification Time" (mtime, the M), "Metadata
            // Modification Time" (the MFT metadata-change time, the C in MACB)
            // and "File Last Modification Time". The original regex caught only
            // the first, leaving 260 of 1240 rows on real images with an empty
            // action. Metadata change (permissions/MFT record) is still a file
            // modification for CAR's purposes, so all three map to "modify".
            // create is tested first, so any overlap resolves in its favour.
            action = case(TimestampDesc matches regex @"(?i)creation|crtime|birth", "create",
                          TimestampDesc matches regex @"(?i)modification|mtime", "modify",
                          TimestampDesc matches regex @"(?i)last access|atime", "read",
                          TimestampDesc matches regex @"(?i)deletion|deleted", "delete",
                          ""),
            file_path     = replace_regex(DisplayName, @"^[A-Z0-9]+:", ""),
            file_name     = replace_regex(replace_regex(DisplayName, @"^[A-Z0-9]+:", ""), @"^.*[\\/]", ""),
            hostname      = Hostname,
            user          = UserName
        | extend creation_time = iff(action == "create", Timestamp, datetime(null))
        | project Timestamp, action, file_name, file_path, hostname, user,
                  creation_time, Origin = "plaso", SourceFile = DisplayName;
    // Sysmon 11 (FileCreate) / 23 (FileDelete) — endpoint file activity with the
    // creating image and user, which the Plaso filesystem view (a MACB timeline,
    // no process context) cannot supply. TargetFilename is the path; file_name is
    // its leaf. 26 (FileDeleteDetected) is deliberately not included: it is the
    // logged-only variant Sysmon emits when archival is off, and mixing it in
    // would double-count deletions on hosts that archive.
    let FromSysmon =
        database("host").EvtxEcmdJson
        | where Provider matches regex @"(?i)sysmon" and EventId in (11, 23)
        | extend
            target   = EvtxPayload(Payload, "TargetFilename"),
            sys_user = EvtxPayload(Payload, "User")
        | project
            Timestamp     = TimeCreated,
            action        = iff(EventId == 11, "create", "delete"),
            file_name     = replace_regex(target, @"^.*[\\/]", ""),
            file_path     = target,
            hostname      = Computer,
            user          = sys_user,
            creation_time = iff(EventId == 11, TimeCreated, datetime(null)),
            Origin        = strcat("sysmon:", tostring(EventId)),
            SourceFile;
    union FromPlaso, FromSysmon
}

//=============================================================================
// CarRegistry — registry key/value activity
//
// Source: Velociraptor offline collectors running the EZ Tools (RECmd /
// Registry Explorer), landed in host.VelociraptorJson. RECmd's per-value output
// carries KeyPath / ValueName / ValueData / ValueType / HivePath and the key's
// LastWriteTimestamp — the same Zimmerman field names the retired KapeJson
// mapping used, so this is a projection, not a translation.
//
// The Artefact filter is broad (recmd|registry|regexplorer) so any of the
// EZ-tool registry artefact names a collector might emit are picked up. action
// is "modify": a registry hive records a key's LAST write, so a present row
// means the key was created or changed — dead-box cannot distinguish the two,
// and defaulting to the weaker claim is the honest choice.
//
// hostname is derived from the per-host collection directory in SourceFile
// (velociraptor/<host>/...), since RECmd output itself carries no hostname.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'registry' object (Velociraptor RECmd + Sysmon 12/13/14)", folder = "CAR")
CarRegistry() {
    let FromVelociraptor =
        database("host").VelociraptorJson
        | where Artefact matches regex @"(?i)recmd|registry|regexplorer"
        | extend
            Timestamp  = todatetime(coalesce(Record.LastWriteTimestamp, Record.LastWriteTime, Record.Mtime)),
            action     = "modify",
            key        = tostring(coalesce(Record.KeyPath, Record.Key)),
            value      = tostring(coalesce(Record.ValueName, Record.Value)),
            data       = tostring(coalesce(Record.ValueData, Record.Data)),
            type       = tostring(coalesce(Record.ValueType, Record.Type)),
            hive       = tostring(coalesce(Record.HivePath, Record.Hive)),
            image_path = tostring(Record.ImagePath),
            pid        = tolong(Record.PID),
            user       = tostring(Record.User),
            hostname   = extract(@"(?i)velociraptor/([^/]+)/", 1, SourceFile),
            fqdn       = extract(@"(?i)velociraptor/([^/]+)/", 1, SourceFile)
        | project Timestamp, action, key, value, data, type, hive, image_path, pid,
                  user, hostname, fqdn, Artefact, SourceFile;
    // Sysmon 12 (key create/delete), 13 (value set), 14 (key/value rename).
    // Unlike the RECmd hive snapshot — which shows a key's LAST state — Sysmon
    // records the CHANGE as it happens, so action comes from EventType rather
    // than defaulting to "modify". TargetObject is the full path; for a value
    // set (13) its leaf is the value name and Details is the data written. pid
    // is decimal (Sysmon), so tolong() directly. type/hive/fqdn have no Sysmon
    // equivalent and stay empty rather than being faked.
    let FromSysmon =
        database("host").EvtxEcmdJson
        | where Provider matches regex @"(?i)sysmon" and EventId in (12, 13, 14)
        | extend
            etype  = EvtxPayload(Payload, "EventType"),
            target = EvtxPayload(Payload, "TargetObject"),
            det    = EvtxPayload(Payload, "Details")
        | project
            Timestamp  = TimeCreated,
            // contains (substring), NOT has: `has` matches whole terms, and
            // Sysmon's EventType is a single camelCase token ("CreateKey"), so
            // `has "Create"` is false and every action fell through to "modify".
            action     = case(etype contains "Delete", "delete",
                              etype contains "Create", "create",
                              etype contains "Set",    "modify",
                              etype contains "Rename", "rename",
                              "modify"),
            key        = target,
            value      = iff(EventId == 13, replace_regex(target, @"^.*\\", ""), ""),
            data       = det,
            type       = "",
            hive       = "",
            image_path = EvtxPayload(Payload, "Image"),
            pid        = tolong(EvtxPayload(Payload, "ProcessId")),
            user       = EvtxPayload(Payload, "User"),
            hostname   = Computer,
            fqdn       = "",
            Artefact   = strcat("sysmon:", tostring(EventId)),
            SourceFile;
    union FromVelociraptor, FromSysmon
}

//=============================================================================
// CarModule — image (DLL) loaded into a process.
//
// Source: Sysmon 7 (Image loaded). ImageLoaded is the module; Image is the
// process that loaded it. Sysmon's Hashes is a single "SHA1=...,MD5=..." string;
// it is kept whole rather than split into guessed columns. Signed/Signature/
// SignatureStatus are present only when the operator shipped the Sysmon config
// that computes them, so they stay null otherwise. High volume by nature — this
// is per-DLL-load — which is exactly why nothing dead-box can approximate it.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'module' object (Sysmon 7 image load)", folder = "CAR")
CarModule() {
    database("host").EvtxEcmdJson
    | where Provider matches regex @"(?i)sysmon" and EventId == 7
    | extend
        module_path     = EvtxPayload(Payload, "ImageLoaded"),
        image_path      = EvtxPayload(Payload, "Image"),
        pid             = tolong(EvtxPayload(Payload, "ProcessId")),
        hashes          = EvtxPayload(Payload, "Hashes"),
        signed          = EvtxPayload(Payload, "Signed"),
        signature       = EvtxPayload(Payload, "Signature"),
        signature_status= EvtxPayload(Payload, "SignatureStatus")
    | project
        Timestamp   = TimeCreated,
        action      = "load",
        module_name = replace_regex(EvtxPayload(Payload, "ImageLoaded"), @"^.*[\\/]", ""),
        module_path, image_path, pid, hashes, signed, signature,
        signature_status,
        hostname    = Computer,
        SourceFile
}

//=============================================================================
// CarDriver — kernel driver loaded.
//
// Source: Sysmon 6 (Driver loaded). A driver loads into the kernel, not a
// user process, so there is no pid or loading image — ImageLoaded is the driver
// binary itself. The signature fields are the point of this event: an unsigned
// or self-signed driver load is a classic rootkit / BYOVD tell, so Signed /
// Signature / SignatureStatus are carried even though they are often null on
// hosts whose Sysmon config does not compute them.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'driver' object (Sysmon 6 driver load)", folder = "CAR")
CarDriver() {
    database("host").EvtxEcmdJson
    | where Provider matches regex @"(?i)sysmon" and EventId == 6
    | extend
        module_path      = EvtxPayload(Payload, "ImageLoaded"),
        hashes           = EvtxPayload(Payload, "Hashes"),
        signed           = EvtxPayload(Payload, "Signed"),
        signature        = EvtxPayload(Payload, "Signature"),
        signature_status = EvtxPayload(Payload, "SignatureStatus")
    | project
        Timestamp   = TimeCreated,
        action      = "load",
        module_name = replace_regex(EvtxPayload(Payload, "ImageLoaded"), @"^.*[\\/]", ""),
        module_path, hashes, signed, signature, signature_status,
        hostname    = Computer,
        SourceFile
}

//=============================================================================
// CarThread — remote thread created in another process.
//
// Source: Sysmon 8 (CreateRemoteThread). This is the cross-process injection
// primitive: a Source process creating a thread inside a Target process.
// StartAddress / StartModule / StartFunction describe where the new thread
// begins — a start address with no backing module is the shellcode-injection
// signature. Both PIDs are decimal (Sysmon), so tolong() directly.
//=============================================================================
.create-or-alter function
with (docstring = "MITRE CAR 'thread' object (Sysmon 8 CreateRemoteThread)", folder = "CAR")
CarThread() {
    database("host").EvtxEcmdJson
    | where Provider matches regex @"(?i)sysmon" and EventId == 8
    | project
        Timestamp      = TimeCreated,
        action         = "create",
        src_pid        = tolong(EvtxPayload(Payload, "SourceProcessId")),
        src_image      = EvtxPayload(Payload, "SourceImage"),
        target_pid     = tolong(EvtxPayload(Payload, "TargetProcessId")),
        target_image   = EvtxPayload(Payload, "TargetImage"),
        new_tid        = tolong(EvtxPayload(Payload, "NewThreadId")),
        start_address  = EvtxPayload(Payload, "StartAddress"),
        start_module   = EvtxPayload(Payload, "StartModule"),
        start_function = EvtxPayload(Payload, "StartFunction"),
        hostname       = Computer,
        SourceFile
}

//=============================================================================
// CarCoverage — which objects actually have data.
//
// The equivalent of `| tstats count FROM datamodel=MITRE_CAR BY nodename` on
// the Splunk era. Run this first after ingesting: an object that should be
// populated and is not means the mapping is wrong, not that the model is.
//
// All nine objects now have a source and count real rows: driver, module and
// thread from Sysmon (events 6/7/8), the other six as before. An object that
// should be populated and shows 0 means the mapping is wrong (or that source
// was not ingested), not that the model is — e.g. driver/module/thread show 0
// on a host with no Sysmon, which is expected, not a defect.
//=============================================================================
.create-or-alter function
with (docstring = "Row counts per CAR object (all nine are sourced)", folder = "CAR")
CarCoverage() {
    union
        (CarFlow()        | summarize Rows = count() | extend Object = "flow"),
        (CarUserSession() | summarize Rows = count() | extend Object = "user_session"),
        (CarProcess()     | summarize Rows = count() | extend Object = "process"),
        (CarService()     | summarize Rows = count() | extend Object = "service"),
        (CarFile()        | summarize Rows = count() | extend Object = "file"),
        (CarRegistry()    | summarize Rows = count() | extend Object = "registry"),
        (CarDriver()      | summarize Rows = count() | extend Object = "driver"),
        (CarModule()      | summarize Rows = count() | extend Object = "module"),
        (CarThread()      | summarize Rows = count() | extend Object = "thread")
    | project Object, Rows
    | order by Rows desc
}
