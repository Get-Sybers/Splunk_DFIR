<form version="1.1" theme="dark">
  <label>L2T - WinEVTX Analysis</label>
  <description>Enhanced analysis of Windows Event Log data from log2timeline output</description>
  <!-- New summary statistics row -->
  <!-- New Event Category Analysis -->
  <!-- New Security Events Analysis Section -->
  <!-- New Authentication Events Analysis -->
  <!-- New Process Execution Analysis -->
  <!-- New Unusual/Suspicious Events -->
  <!-- New Event Timeline Visualization -->
  <!-- New detailed events table with filtering -->
  <fieldset submitButton="false">
    <input type="time" token="timetoken">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="hostFilter">
      <label>Host Filter</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>computer_name</fieldForLabel>
      <fieldForValue>computer_name</fieldForValue>
      <search>
        <query>index=host sourcetype="l2t:winevtx" 
| stats count by computer_name
| sort computer_name</query>
      </search>
    </input>
    <input type="dropdown" token="provider_token">
      <label>Windows Event Source</label>
      <choice value="*">All Sources</choice>
      <default>*</default>
      <populatingSearch fieldForLabel="provider" fieldForValue="provider">
        <![CDATA[index=host sourcetype="l2t:winevtx"
| search computer_name=$hostFilter$
| stats count by provider
| sort -count]]>
      </populatingSearch>
    </input>
    <input type="multiselect" token="event_id">
      <label>Event ID</label>
      <choice value="*">All Event IDs</choice>
      <default>*</default>
      <populatingSearch fieldForLabel="event_id" fieldForValue="event_id">
        <![CDATA[index=host sourcetype="l2t:winevtx"
| search provider=$provider_token$ computer_name=$hostFilter$
| stats count by event_id
| sort -count]]>
      </populatingSearch>
    </input>
    <input type="text" token="stringtoken">
      <label>String Search</label>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Total Events</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host sourcetype="l2t:winevtx" 
| search event_id=$event_id$ provider=$provider_token$ computer_name=$hostFilter$
| stats count]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">1</option>
        <option name="showTrendIndicator">1</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
        <option name="rangeColors">["0x53a051", "0x0877a6", "0xf8be34", "0xf1813f", "0xdc4e41"]</option>
        <option name="underLabel">Events</option>
      </single>
    </panel>
    <panel>
      <title>Unique Event IDs</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host sourcetype="l2t:winevtx" 
| search provider=$provider_token$
| search event_id=$event_id$ computer_name=$hostFilter$
| stats dc(event_id)]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">1</option>
        <option name="showTrendIndicator">1</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
        <option name="rangeColors">["0x53a051", "0x0877a6", "0xf8be34", "0xf1813f", "0xdc4e41"]</option>
        <option name="underLabel">Event Types</option>
      </single>
    </panel>
    <panel>
      <title>Most Recent Event</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host sourcetype="l2t:winevtx"
| search provider=$provider_token$ computer_name=$hostFilter$
| search event_id=$event_id$
| sort -_time
| head 1
| convert timeformat="%Y-%m-%d %H:%M:%S" ctime(_time) as recent_event
| table recent_event]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
        <option name="rangeColors">["0x53a051", "0x0877a6", "0xf8be34", "0xf1813f", "0xdc4e41"]</option>
        <option name="underLabel">Last Event Time</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Detailed Event Log Entries</title>
      <table>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| table datetime, computer_name, provider, event_id, message
| sort -datetime</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="count">5</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">cell</option>
        <option name="percentagesRow">false</option>
        <option name="rowNumbers">false</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Event Volume Over Time</title>
      <chart>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| timechart span=30m count</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.axisLabelsX.majorLabelStyle.overflowMode">ellipsisNone</option>
        <option name="charting.axisLabelsX.majorLabelStyle.rotation">0</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleX.visibility">visible</option>
        <option name="charting.axisTitleY.text">Event Count</option>
        <option name="charting.axisTitleY.visibility">visible</option>
        <option name="charting.chart">area</option>
        <option name="charting.chart.bubbleMaximumSize">50</option>
        <option name="charting.chart.bubbleMinimumSize">10</option>
        <option name="charting.chart.nullValueMode">gaps</option>
        <option name="charting.chart.showDataLabels">none</option>
        <option name="charting.chart.sliceCollapsingThreshold">0.01</option>
        <option name="charting.chart.stackMode">default</option>
        <option name="charting.chart.style">shiny</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.layout.splitSeries">0</option>
        <option name="charting.layout.splitSeries.allowIndependentYRanges">0</option>
        <option name="charting.legend.labelStyle.overflowMode">ellipsisMiddle</option>
        <option name="charting.legend.placement">right</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Events Over Time</title>
      <chart>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| timechart count by event_id limit=10</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Count By WinEventLog</title>
      <chart>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| stats count by provider</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Count By Event Id</title>
      <chart>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| stats count by event_id</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Event Categories</title>
      <chart>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| eval category=case(
    match(provider, "Security"), "Security",
    match(provider, "System"), "System",
    match(provider, "Application"), "Application",
    match(provider, "Setup"), "Setup",
    match(provider, "Microsoft-Windows-PowerShell"), "PowerShell",
    match(provider, "BITS"), "Background Tasks",
    match(provider, "Microsoft-Windows-TerminalServices"), "Remote Desktop",
    match(provider, "Microsoft-Windows-Sysmon"), "Sysmon",
    match(provider, "Microsoft-Windows-Windows Defender"), "Windows Defender",
    true(), "Other"
)
| stats count by category
| sort -count</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Events by Computer</title>
      <chart>
        <search>
          <query>index=host sourcetype="l2t:winevtx" message=$stringtoken$
| search provider=$provider_token$ computer_name=$hostFilter$ event_id=$event_id$
| stats count by computer_name</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
</form>