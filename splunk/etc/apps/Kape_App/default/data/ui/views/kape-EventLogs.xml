<form version="1.1" theme="dark">
  <label>KAPE Event Logs</label>
  <description>Analysis of Windows Event Logs captured by KAPE</description>
  <!-- Summary Stats Panel -->
  <!-- Visualization Row -->
  <!-- Main Results Table -->
  <!-- Additional Analysis -->
  <fieldset submitButton="false">
    <input type="time" token="timetoken" searchWhenChanged="true">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="hosttoken" searchWhenChanged="true">
      <label>Host</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*
| stats count by host
| sort host</query>
        <earliest>0</earliest>
        <latest></latest>
      </search>
    </input>
    <input type="dropdown" token="providertoken" searchWhenChanged="true">
      <label>Event Provider</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>Provider</fieldForLabel>
      <fieldForValue>Provider</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*EventLogs
| stats count by Provider
| sort Provider</query>
        <earliest>0</earliest>
        <latest></latest>
      </search>
    </input>
    <input type="checkbox" token="eventidtoken" searchWhenChanged="true">
      <label>Event ID</label>
      <default>*</default>
      <prefix>*</prefix>
      <suffix>*</suffix>
      <initialValue>*</initialValue>
      <choice value="*">All</choice>
      <fieldForLabel>EventId</fieldForLabel>
      <fieldForValue>EventId</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*EventLogs provider=$providertoken$
| stats count by EventId
| table EventId
| sort EventId</query>
      </search>
    </input>
    <input type="dropdown" token="usernametoken" searchWhenChanged="true">
      <label>Username</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>UserName</fieldForLabel>
      <fieldForValue>UserName</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*EventLogs
| stats count by UserName
| sort UserName</query>
        <earliest>0</earliest>
        <latest></latest>
      </search>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Total Events</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$ 
| stats count as "Total Events"]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="underLabel">Total Events</option>
      </single>
    </panel>
    <panel>
      <title>Unique Users</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$
| stats dc(UserName) as "Unique Users"]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="underLabel">Users Associated with Events</option>
      </single>
    </panel>
    <panel>
      <title>Unique Providers</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$
| stats dc(Provider) as "Unique Providers"]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="underLabel">Event Providers</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Events Over Time</title>
      <chart>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$
| timechart span=1h count]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Top Event IDs</title>
      <chart>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$
| stats count by EventId
| sort -count
| head 10]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Top Hosts</title>
      <chart>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$
| stats count by host
| sort -count
| head 10]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Recent Event Log Entries</title>
      <table>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*EventLogs Provider=$providertoken$ EventId=$eventidtoken$ UserName=$usernametoken$
| eval EventTime=strftime(_time, "%Y-%m-%d %H:%M:%S")
| table EventTime, host, Provider, EventId, UserName, SourceName, Message
| sort -EventTime]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>