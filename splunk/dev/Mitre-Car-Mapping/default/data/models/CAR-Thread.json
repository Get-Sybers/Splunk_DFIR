{
  "modelName": "CAR-Thread",
  "displayName": "CAR Thread",
  "description": "A thread is the basic unit to which an operating system allocates processor time, and consists of a sequence of instructions, a program counter, and a set of data registers.",
  "editable": false,
  "objects": [
    {
      "objectName": "CARThread",
      "displayName": "CAR Thread",
      "parentName": "BaseEvent",
      "fields": [
        {
          "fieldName": "hostname",
          "displayName": "hostname",
          "type": "string",
          "comment": {
            "description": "Hostname of the machine on which the thread event occurred.",
            "example": "HOST1"
          }
        },
        {
          "fieldName": "src_pid",
          "displayName": "src_pid",
          "type": "number",
          "comment": {
            "description": "Process ID of the source process involved in the thread operation.",
            "example": 4680
          }
        },
        {
          "fieldName": "src_tid",
          "displayName": "src_tid",
          "type": "number",
          "comment": {
            "description": "Thread ID of the source thread.",
            "example": 5980
          }
        },
        {
          "fieldName": "stack_base",
          "displayName": "stack_base",
          "type": "string",
          "comment": {
            "description": "Base address of the thread's stack.",
            "example": "0x00007FF7253C0000"
          }
        },
        {
          "fieldName": "stack_limit",
          "displayName": "stack_limit",
          "type": "string",
          "comment": {
            "description": "Upper limit of the thread's stack.",
            "example": "0x00007FF7253D0000"
          }
        },
        {
          "fieldName": "start_address",
          "displayName": "start_address",
          "type": "string",
          "comment": {
            "description": "Memory address of the initial function called by the thread.",
            "example": "0x00007FF725FC1040"
          }
        },
        {
          "fieldName": "subprocess_tag",
          "displayName": "subprocess_tag",
          "type": "number",
          "comment": {
            "description": "A unique identifier within the process for the new thread.",
            "example": 0
          }
        },
        {
          "fieldName": "tgt_pid",
          "displayName": "tgt_pid",
          "type": "number",
          "comment": {
            "description": "Target process ID (for remote thread creation).",
            "example": 2460
          }
        },
        {
          "fieldName": "tgt_tid",
          "displayName": "tgt_tid",
          "type": "number",
          "comment": {
            "description": "Target thread ID.",
            "example": 3540
          }
        },
        {
          "fieldName": "user",
          "displayName": "user",
          "type": "string",
          "comment": {
            "description": "User context under which the thread is executing.",
            "example": "HOST1\\LOCALUSER"
          }
        },
        {
          "fieldName": "user_stack_base",
          "displayName": "user_stack_base",
          "type": "string",
          "comment": {
            "description": "Base address of the thread's user-mode stack.",
            "example": "0x00000B723CD60000"
          }
        },
        {
          "fieldName": "user_stack_limit",
          "displayName": "user_stack_limit",
          "type": "string",
          "comment": {
            "description": "Upper limit of the thread's user-mode stack.",
            "example": "0x00000B723CD68000"
          }
        },
        {
          "fieldName": "start_function",
          "displayName": "start_function",
          "type": "string",
          "comment": {
            "description": "Name of the function at the start_address.",
            "example": "BaseThreadInitThunk"
          }
        },
        {
          "fieldName": "start_module",
          "displayName": "start_module",
          "type": "string",
          "comment": {
            "description": "Full path of the module containing the start address.",
            "example": "C:\\Windows\\System32\\kernel32.dll"
          }
        },
        {
          "fieldName": "start_module_name",
          "displayName": "start_module_name",
          "type": "string",
          "comment": {
            "description": "Name of the module containing the start address.",
            "example": "kernel32.dll"
          }
        }
      ],
      "calculations": [
        {
          "calculationID": "Thread_Action_Create",
          "calculationType": "Eval",
          "expression": "if(isnull(create) OR create==\"\", \"unknown\", create)",
          "outputFields": [
            {
              "fieldName": "create",
              "displayName": "create",
              "type": "string",
              "comment": {
                "description": "Thread creation event."
              }
            }
          ]
        },
        {
          "calculationID": "Thread_Action_Suspend",
          "calculationType": "Eval",
          "expression": "if(isnull(suspend) OR suspend==\"\", \"unknown\", suspend)",
          "outputFields": [
            {
              "fieldName": "suspend",
              "displayName": "suspend",
              "type": "string",
              "comment": {
                "description": "Thread suspension event."
              }
            }
          ]
        },
        {
          "calculationID": "Thread_Action_Terminate",
          "calculationType": "Eval",
          "expression": "if(isnull(terminate) OR terminate==\"\", \"unknown\", terminate)",
          "outputFields": [
            {
              "fieldName": "terminate",
              "displayName": "terminate",
              "type": "string",
              "comment": {
                "description": "Thread termination event."
              }
            }
          ]
        },
        {
          "calculationID": "Thread_Action_Remote_Create",
          "calculationType": "Eval",
          "expression": "if(isnull(remote_create) OR remote_create==\"\", \"unknown\", remote_create)",
          "outputFields": [
            {
              "fieldName": "remote_create",
              "displayName": "remote_create",
              "type": "string",
              "comment": {
                "description": "Remote thread creation event (one process creating a thread in another process)."
              }
            }
          ]
        }
      ],
      "constraints": []
    }
  ]
}