// Database: network — Zeek
//
// scripts/process-zeek-ALL.sh runs Zeek with LogAscii::use_json=T and
// json_timestamps=JSON::TS_ISO8601, so every log is JSON Lines with ISO-8601
// timestamps — one object per row, native JSON types, produced entirely inside
// the container. That is why ingestion here is by JSON PATH, not by TSV ordinal:
// a path mapping is immune to Zeek field reordering (a different Zeek version or
// a site script), where the old ordinal mapping would have silently loaded
// destination addresses into the source column. Zeek's `id` record serialises
// as flat dotted keys ("id.orig_h", "id.resp_p"), read with $['id.orig_h'].
//
// Zeek writes ~69 log types, each a different schema. The split the data itself
// suggests:
//
//   ZeekConn  typed, because conn.log is stable, high-volume, and the one Zeek
//             log the MITRE CAR mapping needs (CarFlow)
//   Zeek      every other log type, semi-structured — one dynamic Record column,
//             the same shape memory.VolatilityJson and host.VelociraptorJson use
//
// The generic table IS populated now (it was not under the TSV path): every
// non-conn log is wrapped {LogType, SourceFile, Record} by ingest-kusto.sh's
// zeek_generic_prepare hook and loaded here, so all 69 log types are queryable
// as Record.field — dns, http, ssl, files, x509, dce_rpc, kerberos, smb, weird,
// notice and the rest.

//=============================================================================
// ZeekConn — conn.log, typed.
//
// Mapped by JSON path, so Zeek's own names (id.orig_h / id.resp_p) do not have
// to be kept as awkward Kusto identifiers, and the columns are CAR-aligned
// (SrcIp, DestPort ...) so CarFlow() is a projection, not a translation.
//
// Native JSON types mean the numeric and boolean columns are typed directly —
// no more '-' / T / F string sentinels to convert. An unset JSON field maps to
// null, which is the honest representation the TSV '-' sentinel only approximated.
//=============================================================================
.create-merge table ZeekConn (
    Ts:            datetime,
    Uid:           string,
    SrcIp:         string,
    SrcPort:       int,
    DestIp:        string,
    DestPort:      int,
    Proto:         string,
    Service:       string,
    Duration:      real,
    OrigBytes:     long,
    RespBytes:     long,
    ConnState:     string,
    LocalOrig:     bool,
    LocalResp:     bool,
    MissedBytes:   long,
    History:       string,
    OrigPkts:      long,
    OrigIpBytes:   long,
    RespPkts:      long,
    RespIpBytes:   long,
    TunnelParents: dynamic
)

// No SourceFile column. conn.json is ingested as-is (no per-file wrapper), and
// `.ingest into` cannot inject a constant, so a SourceFile column could never be
// populated on this path and would read as "no data". Provenance for conn is
// available via extent_tags() if the loader is changed to tag each command; the
// generic Zeek table below DOES carry SourceFile, because its wrapper adds it.
.create-or-alter table ZeekConn ingestion json mapping "ZeekConnMapping"
```[
  {"Column":"Ts",           "Properties":{"Path":"$.ts"}},
  {"Column":"Uid",          "Properties":{"Path":"$.uid"}},
  {"Column":"SrcIp",        "Properties":{"Path":"$['id.orig_h']"}},
  {"Column":"SrcPort",      "Properties":{"Path":"$['id.orig_p']"}},
  {"Column":"DestIp",       "Properties":{"Path":"$['id.resp_h']"}},
  {"Column":"DestPort",     "Properties":{"Path":"$['id.resp_p']"}},
  {"Column":"Proto",        "Properties":{"Path":"$.proto"}},
  {"Column":"Service",      "Properties":{"Path":"$.service"}},
  {"Column":"Duration",     "Properties":{"Path":"$.duration"}},
  {"Column":"OrigBytes",    "Properties":{"Path":"$.orig_bytes"}},
  {"Column":"RespBytes",    "Properties":{"Path":"$.resp_bytes"}},
  {"Column":"ConnState",    "Properties":{"Path":"$.conn_state"}},
  {"Column":"LocalOrig",    "Properties":{"Path":"$.local_orig"}},
  {"Column":"LocalResp",    "Properties":{"Path":"$.local_resp"}},
  {"Column":"MissedBytes",  "Properties":{"Path":"$.missed_bytes"}},
  {"Column":"History",      "Properties":{"Path":"$.history"}},
  {"Column":"OrigPkts",     "Properties":{"Path":"$.orig_pkts"}},
  {"Column":"OrigIpBytes",  "Properties":{"Path":"$.orig_ip_bytes"}},
  {"Column":"RespPkts",     "Properties":{"Path":"$.resp_pkts"}},
  {"Column":"RespIpBytes",  "Properties":{"Path":"$.resp_ip_bytes"}},
  {"Column":"TunnelParents","Properties":{"Path":"$.tunnel_parents"}}
]```

//=============================================================================
// Zeek — every other log type, semi-structured.
//
// LogType comes from the filename (dns.json -> "dns"), replacing what
// Splunk_TA_zeek's zeek_autotype transform did with sourcetypes. Record holds
// the whole Zeek object so every field stays queryable (Record.query,
// Record.["id.resp_h"], ...). Ts is lifted out of Record.ts by the mapping so
// the table can be time-filtered without reaching into the dynamic column.
//
// LogType, SourceFile and Ts are per-file/per-record values .ingest cannot
// inject from the raw log, so ingest-kusto.sh's zeek_generic_prepare hook wraps
// each JSON line as {LogType, SourceFile, Record} before loading — the same
// constant-injection pattern the Volatility and Velociraptor loaders use.
//=============================================================================
.create-merge table Zeek (
    LogType:    string,
    SourceFile: string,
    Ts:         datetime,
    Record:     dynamic
)

.create-or-alter table Zeek ingestion json mapping "ZeekJsonMapping"
```[
  {"Column":"LogType",    "Properties":{"Path":"$.LogType"}},
  {"Column":"SourceFile", "Properties":{"Path":"$.SourceFile"}},
  {"Column":"Ts",         "Properties":{"Path":"$.Record.ts"}},
  {"Column":"Record",     "Properties":{"Path":"$.Record"}}
]```

//=============================================================================
// Views
//=============================================================================

// ZeekTyped once converted Zeek's TSV '-'/T/F sentinels; with JSON the columns
// are already typed, so it now only exposes the aliases CarFlow() reads
// (DurationSec / OrigPktsN / RespPktsN and the boolean forms). Kept so CarFlow
// and any downstream query need not change with the JSON cutover.
.create-or-alter function
with (docstring = "ZeekConn with the numeric/boolean aliases CarFlow expects", folder = "Views")
ZeekTyped() {
    ZeekConn
    | extend
        DurationSec = Duration,
        OrigBytesN  = OrigBytes,
        RespBytesN  = RespBytes,
        OrigPktsN   = OrigPkts,
        RespPktsN   = RespPkts,
        LocalOrigB  = LocalOrig,
        LocalRespB  = LocalResp
}

.create-or-alter function
with (docstring = "Completed TCP connections (conn_state SF)", folder = "Views")
ZeekCompletedConnections() {
    ZeekConn
    | where ConnState == "SF"
}

.create-or-alter function
with (docstring = "Connections to non-RFC1918 destinations", folder = "Views")
ZeekEgress() {
    ZeekConn
    | where not(ipv4_is_private(DestIp))
}

// One log type out of the generic table, e.g. ZeekLog("dns").
.create-or-alter function
with (docstring = "All rows of one generic Zeek log type", folder = "Views")
ZeekLog(logType:string) {
    Zeek
    | where LogType == logType
}

// The security-relevant logs, projected out of the dynamic Record so the
// common fields are typed and named. These are views, not tables — the data
// lives once in Zeek; adding a projection costs nothing and drops none of the
// other fields (they remain in Record).
.create-or-alter function
with (docstring = "Zeek dns.log — queries and answers", folder = "Views")
ZeekDns() {
    Zeek
    | where LogType == "dns"
    | project Ts, Uid = tostring(Record.uid),
              SrcIp = tostring(Record.["id.orig_h"]), DestIp = tostring(Record.["id.resp_h"]),
              Query = tostring(Record.query), QType = tostring(Record.qtype_name),
              RCode = tostring(Record.rcode_name), Answers = Record.answers, Record
}

.create-or-alter function
with (docstring = "Zeek http.log — requests", folder = "Views")
ZeekHttp() {
    Zeek
    | where LogType == "http"
    | project Ts, Uid = tostring(Record.uid),
              SrcIp = tostring(Record.["id.orig_h"]), DestIp = tostring(Record.["id.resp_h"]),
              Method = tostring(Record.method), Host = tostring(Record.host),
              Uri = tostring(Record.uri), Status = toint(Record.status_code),
              UserAgent = tostring(Record.user_agent), Record
}

.create-or-alter function
with (docstring = "Zeek ssl.log — TLS handshakes", folder = "Views")
ZeekSsl() {
    Zeek
    | where LogType == "ssl"
    | project Ts, Uid = tostring(Record.uid),
              SrcIp = tostring(Record.["id.orig_h"]), DestIp = tostring(Record.["id.resp_h"]),
              Version = tostring(Record.version), Cipher = tostring(Record.cipher),
              ServerName = tostring(Record.server_name), Ja3 = tostring(Record.ja3), Record
}

.create-or-alter function
with (docstring = "Distinct generic Zeek log types present, with row counts", folder = "Views")
ZeekLogTypes() {
    Zeek
    | summarize Rows = count() by LogType
    | order by Rows desc
}
