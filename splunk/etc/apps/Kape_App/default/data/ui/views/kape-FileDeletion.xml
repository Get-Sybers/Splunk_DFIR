<form version="1.1" theme="dark">
  <label>KAPE File Deletion Analysis</label>
  <description>Analysis of file deletion events captured by KAPE</description>
  <!-- Summary Stats Panel -->
  <!-- Visualization Row -->
  <!-- Main Results Table -->
  <!-- Additional Analysis -->
  <fieldset submitButton="false">
    <input type="time" token="timetoken" searchWhenChanged="true">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="hosttoken" searchWhenChanged="true">
      <label>Host</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*
| stats count by host
| sort host</query>
        <earliest>0</earliest>
        <latest></latest>
      </search>
    </input>
    <input type="dropdown" token="filetypetoken" searchWhenChanged="true">
      <label>File Type</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>FileType</fieldForLabel>
      <fieldForValue>FileType</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*FileDeletion
| stats count by FileType
| sort FileType</query>
        <earliest>0</earliest>
        <latest></latest>
      </search>
    </input>
    <input type="text" token="deletedfiletoken" searchWhenChanged="true">
      <label>Deleted File</label>
      <default>*</default>
      <prefix>*</prefix>
      <suffix>*</suffix>
      <initialValue>*</initialValue>
    </input>
    <input type="dropdown" token="sources" searchWhenChanged="true">
      <label>Source SID</label>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>sid</fieldForLabel>
      <fieldForValue>sid</fieldForValue>
      <search>
        <query>index=host sourcetype=kape*FileDeletion
| rex field=SourceName "(?&lt;drive&gt;\w\:)\\\\?\$Recycle\.Bin\\\\(?&lt;sid&gt;S\-\d\-\d\-\d+(\-\d+)+)[\\\\\"]"
| stats count by sid
| sort sid</query>
        <earliest>0</earliest>
        <latest></latest>
      </search>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Summary Statistics</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*FileDeletion FileType=$filetypetoken$ FileName=$deletedfiletoken$ SourceName=*$sources$* 
| stats count as "Total Deletions"]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="underLabel">Total Deletion Events</option>
      </single>
    </panel>
    <panel>
      <title>Unique Files</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*FileDeletion FileType=$filetypetoken$ FileName=$deletedfiletoken$ SourceName=*$sources$*
| stats dc(FileName) as "Unique Files"]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="underLabel">Unique Files Deleted</option>
      </single>
    </panel>
    <panel>
      <title>Unique Users</title>
      <single>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*FileDeletion FileType=$filetypetoken$ FileName=$deletedfiletoken$ SourceName=*$sources$*
| rex field=SourceName "(?<drive>\w\:)\\\\?\$Recycle\.Bin\\\\(?<sid>S\-\d\-\d\-\d+(\-\d+)+)[\\\\\"]"
| stats dc(sid) as "Unique Users"]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="underLabel">Unique Users Deleting Files</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Deletions Over Time</title>
      <chart>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*FileDeletion FileType=$filetypetoken$ FileName=$deletedfiletoken$ SourceName=*$sources$*
| timechart span=1h count]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Top Users Deleting Files</title>
      <chart>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*FileDeletion FileType=$filetypetoken$ FileName=$deletedfiletoken$ SourceName=*$sources$*
| rex field=SourceName "(?<drive>\w\:)\\\\?\$Recycle\.Bin\\\\(?<sid>S\-\d\-\d\-\d+(\-\d+)+)[\\\\\"]"
| stats count by sid
| sort -count
| head 10]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Detailed File Deletion Events</title>
      <table>
        <search>
          <query>
            <![CDATA[index=host host=$hosttoken$ sourcetype=kape*FileDeletion FileType=$filetypetoken$ FileName=$deletedfiletoken$ SourceName=*$sources$*
| rex field=SourceName "(?<drive>\w\:)\\\\?\$Recycle\.Bin\\\\(?<sid>S\-\d\-\d\-\d+(\-\d+)+)[\\\\\"]"
| eval DeletedTime=strftime(_time, "%Y-%m-%d %H:%M:%S")
| table DeletedTime, host, FileName, FileType, SourceName, sid
| sort -DeletedTime]]>
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
        <format type="color" field="FileType">
          <colorPalette type="map">{"exe":#DC4E41,"dll":#F1813F,"doc":#5CC05C,"docx":#5CC05C,"xls":#2DA2D9,"xlsx":#2DA2D9,"pdf":#6A5ACD}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
</form>