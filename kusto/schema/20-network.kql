// Database: network — Zeek
//
// Zeek writes one TSV per log type, 69 of them, each with a different schema.
// Typing all 69 would be a schema-maintenance burden with no payoff, so this
// takes the same split the data itself suggests:
//
//   ZeekConn  typed, because conn.log is stable, high-volume, and the only
//             Zeek log the MITRE CAR mapping needs (car_flow)
//   Zeek      everything else, semi-structured, one dynamic column
//
// Both are fed from `zeek-cut -C -U "%Y-%m-%dT%H:%M:%S%z"` output, which is
// TSV with '#'-prefixed header lines. Kusto has no property to skip those, so
// scripts/ingest-kusto.sh strips them before ingesting — see the note there.

//=============================================================================
// ZeekConn — conn.log
//
// Column names are already CAR-aligned (SrcIp, DestPort ...) so the car_flow
// function is a projection rather than a translation. Zeek's own names are
// id.orig_h / id.resp_p; the dots make them awkward as Kusto identifiers, and
// mapping by ordinal means we do not have to keep them.
//=============================================================================
.create-merge table ZeekConn (
    Ts:            datetime,
    Uid:           string,
    SrcIp:         string,
    SrcPort:       int,
    DestIp:        string,
    DestPort:      int,
    Proto:         string,
    Service:       string,
    Duration:      string,
    OrigBytes:     string,
    RespBytes:     string,
    ConnState:     string,
    // Zeek writes T/F for booleans and '-' for unset, neither of which Kusto's
    // csv parser accepts as bool/numeric — they would silently become null.
    // Kept as strings and converted in the views below, where the sentinel is
    // visible rather than indistinguishable from "no data".
    LocalOrig:     string,
    LocalResp:     string,
    MissedBytes:   string,
    History:       string,
    OrigPkts:      string,
    OrigIpBytes:   string,
    RespPkts:      string,
    RespIpBytes:   string,
    TunnelParents: string
)

// No SourceFile column. `.ingest into` cannot inject a constant, and the
// mapping below covers ordinals 0-20 — so a SourceFile column could never be
// populated by this path and would read as "no data" rather than "not
// captured". Per-ingestion provenance is available via extent_tags() if the
// loader is changed to tag each command, or via a per-source ingestion mapping
// using a ConstValue property. Neither is wired up; an empty column pretending
// otherwise is worse than its absence.

.create-or-alter table ZeekConn ingestion csv mapping "ZeekConnMapping"
```[
  {"Column":"Ts",           "Properties":{"Ordinal":"0"}},
  {"Column":"Uid",          "Properties":{"Ordinal":"1"}},
  {"Column":"SrcIp",        "Properties":{"Ordinal":"2"}},
  {"Column":"SrcPort",      "Properties":{"Ordinal":"3"}},
  {"Column":"DestIp",       "Properties":{"Ordinal":"4"}},
  {"Column":"DestPort",     "Properties":{"Ordinal":"5"}},
  {"Column":"Proto",        "Properties":{"Ordinal":"6"}},
  {"Column":"Service",      "Properties":{"Ordinal":"7"}},
  {"Column":"Duration",     "Properties":{"Ordinal":"8"}},
  {"Column":"OrigBytes",    "Properties":{"Ordinal":"9"}},
  {"Column":"RespBytes",    "Properties":{"Ordinal":"10"}},
  {"Column":"ConnState",    "Properties":{"Ordinal":"11"}},
  {"Column":"LocalOrig",    "Properties":{"Ordinal":"12"}},
  {"Column":"LocalResp",    "Properties":{"Ordinal":"13"}},
  {"Column":"MissedBytes",  "Properties":{"Ordinal":"14"}},
  {"Column":"History",      "Properties":{"Ordinal":"15"}},
  {"Column":"OrigPkts",     "Properties":{"Ordinal":"16"}},
  {"Column":"OrigIpBytes",  "Properties":{"Ordinal":"17"}},
  {"Column":"RespPkts",     "Properties":{"Ordinal":"18"}},
  {"Column":"RespIpBytes",  "Properties":{"Ordinal":"19"}},
  {"Column":"TunnelParents","Properties":{"Ordinal":"20"}}
]```

//=============================================================================
// Zeek — every other log type.
//
// LogType would come from the filename (dns.log -> "dns"), replacing what
// Splunk_TA_zeek's zeek_autotype transform does with sourcetypes, and Fields
// would hold the '#fields' header so the columns stay recoverable.
//=============================================================================
// NOT POPULATED by any current loader — only conn.log is ingested. LogType,
// SourceFile and Fields would all need per-file constants, which .ingest
// cannot inject (see the note above). Declared so the shape is settled, and
// listed under "What is not done" in docs/Kusto-Port.md.
.create-merge table Zeek (
    LogType:    string,
    SourceFile: string,
    Fields:     string,
    RawLine:    string
)

//=============================================================================
// Views
//
// ZeekTyped converts Zeek's TSV sentinels once, so nothing downstream has to
// remember that '-' means unset and 'T'/'F' mean true/false.
//=============================================================================
.create-or-alter function
with (docstring = "ZeekConn with Zeek's '-' and T/F sentinels converted to real types", folder = "Views")
ZeekTyped() {
    ZeekConn
    | extend
        DurationSec  = todouble(iff(Duration    == "-", "", Duration)),
        OrigBytesN   = tolong(iff(OrigBytes     == "-", "", OrigBytes)),
        RespBytesN   = tolong(iff(RespBytes     == "-", "", RespBytes)),
        OrigPktsN    = tolong(iff(OrigPkts      == "-", "", OrigPkts)),
        RespPktsN    = tolong(iff(RespPkts      == "-", "", RespPkts)),
        LocalOrigB   = iff(LocalOrig == "-", bool(null), LocalOrig == "T"),
        LocalRespB   = iff(LocalResp == "-", bool(null), LocalResp == "T")
}
.create-or-alter function
with (docstring = "Completed TCP connections (conn_state SF)", folder = "Views")
ZeekCompletedConnections() {
    ZeekConn
    | where ConnState == "SF"
}

.create-or-alter function
with (docstring = "Connections to non-RFC1918 destinations", folder = "Views")
ZeekEgress() {
    ZeekConn
    | where not(ipv4_is_private(DestIp))
}
