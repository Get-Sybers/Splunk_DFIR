{
    "modelName": "CAR-Socket",
    "displayName": "CAR Socket",
    "description": "Socket events are low-level events that may or may not result in a flow. Socket listening events in particular can be helpful in detecting malicious activity.",
    "editable": false,
    "objects": [
      {
        "objectName": "CARSocket",
        "displayName": "CAR Socket",
        "parentName": "BaseEvent",
        "fields": [
          {
            "fieldName": "pid",
            "displayName": "pid",
            "type": "number",
            "comment": {
              "description": "Process ID of the process that created or interacted with the socket.",
              "example": 1234
            }
          },
          {
            "fieldName": "ppid",
            "displayName": "ppid",
            "type": "number",
            "comment": {
              "description": "Parent process ID of the process owning the socket.",
              "example": 1860
            }
          },
          {
            "fieldName": "exe",
            "displayName": "exe",
            "type": "string",
            "comment": {
              "description": "Name of the executable associated with the socket.",
              "example": "chrome.exe"
            }
          },
          {
            "fieldName": "image_path",
            "displayName": "image_path",
            "type": "string",
            "comment": {
              "description": "Path of the executable that created or interacted with the socket.",
              "example": "C:\\Windows\\System32\\svchost.exe"
            }
          },
          {
            "fieldName": "command_line",
            "displayName": "command_line",
            "type": "string",
            "comment": {
              "description": "Command line of the process that created the socket.",
              "example": "chrome.exe --no-sandbox"
            }
          },
          {
            "fieldName": "user",
            "displayName": "user",
            "type": "string",
            "comment": {
              "description": "User context under which the socket was created.",
              "example": "HOST1\\LOCALUSER"
            }
          },
          {
            "fieldName": "created_time",
            "displayName": "created_time",
            "type": "string",
            "comment": {
              "description": "Time when the socket was created.",
              "example": "05/14/2015 11:59:59 PM"
            }
          },
          {
            "fieldName": "fqdn",
            "displayName": "fqdn",
            "type": "string",
            "comment": {
              "description": "Fully qualified domain name of the host.",
              "example": "HOST1.EXAMPLE_DOMAIN.COM"
            }
          },
          {
            "fieldName": "hostname",
            "displayName": "hostname",
            "type": "string",
            "comment": {
              "description": "Hostname without the domain.",
              "example": "HOST1"
            }
          },
          {
            "fieldName": "success",
            "displayName": "success",
            "type": "boolean",
            "comment": {
              "description": "Whether the socket event was successful.",
              "example": true
            }
          },
          {
            "fieldName": "family",
            "displayName": "family",
            "type": "string",
            "comment": {
              "description": "Type of socket used.",
              "example": "AF_UNIX, AF_INET, AF_INET6"
            }
          },
          {
            "fieldName": "protocol",
            "displayName": "protocol",
            "type": "string",
            "comment": {
              "description": "Transport protocol of the socket.",
              "example": "TCP"
            }
          },
          {
            "fieldName": "local_ip",
            "displayName": "local_ip",
            "type": "string",
            "comment": {
              "description": "Local IP address bound to the socket.",
              "example": "192.168.1.5"
            }
          },
          {
            "fieldName": "local_port",
            "displayName": "local_port",
            "type": "number",
            "comment": {
              "description": "Local port bound to the socket.",
              "example": 443
            }
          },
          {
            "fieldName": "remote_port",
            "displayName": "remote_port",
            "type": "number",
            "comment": {
              "description": "Remote port for the socket connection.",
              "example": 49152
            }
          },
          {
            "fieldName": "remote_ip",
            "displayName": "remote_ip",
            "type": "string",
            "comment": {
              "description": "Remote IP address for the socket connection.",
              "example": "10.0.0.54"
            }
          },
          {
            "fieldName": "local_path",
            "displayName": "local_path",
            "type": "string",
            "comment": {
              "description": "Local filesystem path used by AF_UNIX socket types.",
              "example": "/tmp/foo"
            }
          },
          {
            "fieldName": "socket_type",
            "displayName": "socket_type",
            "type": "string",
            "comment": {
              "description": "Type of socket (TCP, UDP, RAW, etc).",
              "example": "TCP"
            }
          },
          {
            "fieldName": "socket_state",
            "displayName": "socket_state",
            "type": "string",
            "comment": {
              "description": "Current state of the socket (LISTENING, ESTABLISHED, etc).",
              "example": "ESTABLISHED"
            }
          }
        ],
        "calculations": [
          {
            "calculationID": "Socket_Action_Bind",
            "calculationType": "Eval",
            "expression": "if(isnull(bind) OR bind==\"\", \"unknown\", bind)",
            "outputFields": [
              {
                "fieldName": "bind",
                "displayName": "bind",
                "type": "string",
                "comment": {
                  "description": "Socket bind operation."
                }
              }
            ]
          },
          {
            "calculationID": "Socket_Action_Listen",
            "calculationType": "Eval",
            "expression": "if(isnull(listen) OR listen==\"\", \"unknown\", listen)",
            "outputFields": [
              {
                "fieldName": "listen",
                "displayName": "listen",
                "type": "string",
                "comment": {
                  "description": "Socket listen operation."
                }
              }
            ]
          },
          {
            "calculationID": "Socket_Action_Accept",
            "calculationType": "Eval",
            "expression": "if(isnull(accept) OR accept==\"\", \"unknown\", accept)",
            "outputFields": [
              {
                "fieldName": "accept",
                "displayName": "accept",
                "type": "string", 
                "comment": {
                  "description": "Socket accept operation."
                }
              }
            ]
          },
          {
            "calculationID": "Socket_Action_Connect",
            "calculationType": "Eval",
            "expression": "if(isnull(connect) OR connect==\"\", \"unknown\", connect)",
            "outputFields": [
              {
                "fieldName": "connect",
                "displayName": "connect",
                "type": "string",
                "comment": {
                  "description": "Socket connect operation."
                }
              }
            ]
          },
          {
            "calculationID": "Socket_Action_Disconnect",
            "calculationType": "Eval",
            "expression": "if(isnull(disconnect) OR disconnect==\"\", \"unknown\", disconnect)",
            "outputFields": [
              {
                "fieldName": "disconnect",
                "displayName": "disconnect",
                "type": "string",
                "comment": {
                  "description": "Socket disconnect operation."
                }
              }
            ]
          },
          {
            "calculationID": "Socket_Action_Close",
            "calculationType": "Eval",
            "expression": "if(isnull(close) OR close==\"\", \"unknown\", close)",
            "outputFields": [
              {
                "fieldName": "close",
                "displayName": "close",
                "type": "string",
                "comment": {
                  "description": "Socket close operation event."
                }
              }
            ]
          }
        ],
        "constraints": []
      }
    ]
  }