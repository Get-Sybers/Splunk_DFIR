<form version="1.1" theme="dark">
  <label>Log2Timeline App Navigation</label>
  <description>Navigate to comprehensive forensic artifact dashboards for digital investigation and incident response</description>
  <!-- Artifact Summary Row -->
  <!-- Quick Stats Row -->
  <!-- Navigation Cards Row -->
  <!-- Data Overview Row -->
  <fieldset submitButton="false">
    <input type="time" token="timetoken">
      <label>Global Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>📈 Total Events</title>
      <single>
        <search>
          <query>index=host sourcetype=l2t* | stats count</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="underLabel">Total L2T Events</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>
    <panel>
      <title>🖥️ Analyzed Hosts</title>
      <single>
        <search>
          <query>index=host sourcetype=l2t* | stats dc(host)</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="underLabel">Unique Systems</option>
      </single>
    </panel>
    <panel>
      <title>📋 Artifact Types</title>
      <single>
        <search>
          <query>index=host sourcetype=l2t* | stats dc(sourcetype)</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="underLabel">Source Types</option>
      </single>
    </panel>
    <panel>
      <title>📁 Data Sources</title>
      <single>
        <search>
          <query>index=host sourcetype=l2t* | stats dc(source)</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="underLabel">Ingested Files</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>🏠 Host Activity Distribution</title>
      <chart>
        <search>
          <query>
            index=host sourcetype=l2t* 
            | eval host=upper(host)
            | stats count by host
            | sort -count
            | head 10
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="height">300</option>
      </chart>
    </panel>
    <panel>
      <title>📈 Timeline Activity Overview</title>
      <chart>
        <search>
          <query>
            index=host sourcetype=l2t* 
            | eval sourcetype_category=case(
                sourcetype="l2t:winevtx", "Event Logs",
                sourcetype="l2t:registry", "Registry", 
                sourcetype="l2t:NTFS" OR sourcetype="l2t:File", "File System",
                sourcetype="l2t:AppCompatCache", "Program Execution",
                sourcetype="l2t:PE", "Executable Analysis",
                sourcetype="l2t:Network", "Network Activity",
                sourcetype="l2t:Chrome" OR sourcetype="l2t:Google", "Browser Activity",
                true(), "Other"
            )
            | timechart span=1h count by sourcetype_category
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">Event Count</option>
        <option name="height">300</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>📊 Available Forensic Artifacts</title>
      <table>
        <search>
          <query>
            index=host sourcetype=l2t*
            | eval artifact_description=case(
                sourcetype="l2t:winevtx", "Windows Event Logs - Security, System, Application events",
                sourcetype="l2t:registry", "Windows Registry - Configuration, persistence, user activity",
                sourcetype="l2t:NTFS", "NTFS File System - $MFT, file operations, timestamps",
                sourcetype="l2t:File", "File System Activity - File access, modifications, deletions",
                sourcetype="l2t:AppCompatCache", "Application Compatibility Cache - Program execution tracking",
                sourcetype="l2t:PE", "Portable Executable Files - Malware analysis, program forensics",
                sourcetype="l2t:Network", "Network Connections - WiFi, drives, network activity",
                sourcetype="l2t:Chrome", "Chrome Browser - Web history, downloads, user behavior",
                sourcetype="l2t:Google", "Google Services - Gmail, Drive, Calendar, Search activity",
                true(), "Other forensic artifacts"
            )
            | stats count as events, dc(host) as hosts by sourcetype, artifact_description
            | sort -events
          </query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="count">5</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
        <format type="color" field="events">
          <colorPalette type="minMidMax" maxColor="#DC4E41" midColor="#F8BE34" minColor="#53A051"></colorPalette>
          <scale type="minMidMax" midType="percent" midValue="50"></scale>
        </format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <html>
        <style>
          .dashboard-nav {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 15px;
            padding: 20px;
          }
          .nav-card {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            border: 1px solid #5a6c7d;
            border-radius: 8px;
            padding: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
          }
          .nav-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            border-color: #3498db;
          }
          .nav-card h3 {
            color: #3498db;
            margin: 0 0 10px 0;
            font-size: 18px;
          }
          .nav-card p {
            color: #bdc3c7;
            margin: 0 0 15px 0;
            font-size: 14px;
            line-height: 1.4;
          }
          .nav-card .artifacts {
            color: #95a5a6;
            font-size: 12px;
            font-style: italic;
          }
          .section-header {
            color: #e74c3c;
            font-size: 24px;
            margin: 30px 0 20px 0;
            text-align: center;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 10px;
          }
        </style>
        
        <h1 style="text-align: center; color: #ecf0f1; margin-bottom: 10px;">🔍 Log2Timeline Forensic Analysis Suite</h1>
        <p style="text-align: center; color: #95a5a6; margin-bottom: 30px;">Comprehensive digital forensics dashboards for Windows artifact analysis</p>
        
        <div class="section-header">🏠 Overview &amp; Summary</div>
        <div class="dashboard-nav">
          <div class="nav-card" onclick="window.open('L2T-Summary', '_blank')">
            <h3>📊 L2T Summary</h3>
            <p>High-level overview of all log2timeline data sources, event distribution, and ingestion statistics</p>
            <div class="artifacts">Timeline overview • Source analysis • Host distribution</div>
          </div>
        </div>

        <div class="section-header">🔐 Authentication &amp; Access</div>
        <div class="dashboard-nav">
          <div class="nav-card" onclick="window.open('L2T-Enhanced-Logon-Analysis', '_blank')">
            <h3>🔑 Enhanced Logon Analysis</h3>
            <p>Advanced Windows logon analysis with security focus and detailed authentication tracking</p>
            <div class="artifacts">Event 4624/4625 • Authentication packages • Privileged accounts • After hours activity</div>
          </div>
          
          <div class="nav-card" onclick="window.open('L2T-Logon-Pivot-Analysis', '_blank')">
            <h3>🔄 Logon Pivot Analysis</h3>
            <p>Interactive logon analysis with user and computer pivoting capabilities for behavioral analysis</p>
            <div class="artifacts">User-host matrix • Logon patterns • Remote access • Timeline correlation</div>
          </div>
        </div>

        <div class="section-header">🗂️ File System &amp; Registry</div>
        <div class="dashboard-nav">
          <div class="nav-card" onclick="window.open('L2T-NTFS-Files', '_blank')">
            <h3>💾 NTFS File System</h3>
            <p>Comprehensive NTFS $MFT and file system analysis for file activity tracking</p>
            <div class="artifacts">$MFT analysis • USN Journal • File creation/modification • MACB timeline</div>
          </div>
          
          <div class="nav-card" onclick="window.open('L2T-Registry', '_blank')">
            <h3>📋 Registry Forensics</h3>
            <p>Windows Registry analysis for persistence, configuration changes, and malware investigation</p>
            <div class="artifacts">Registry hives • Run keys • Services • User artifacts • Policy changes</div>
          </div>
          
          <div class="nav-card" onclick="window.open('L2T-AppCompatCache', '_blank')">
            <h3>⚡ AppCompatCache</h3>
            <p>Windows Application Compatibility Cache analysis for program execution tracking</p>
            <div class="artifacts">ShimCache • Program execution • Execution paths • Timeline correlation</div>
          </div>
        </div>

        <div class="section-header">🔧 Executables &amp; Programs</div>
        <div class="dashboard-nav">
          <div class="nav-card" onclick="window.open('L2T-Portable-Executeable', '_blank')">
            <h3>⚙️ PE File Analysis</h3>
            <p>Portable Executable analysis for malware detection and program forensics</p>
            <div class="artifacts">PE headers • Import/Export tables • DLL analysis • Security assessment</div>
          </div>
        </div>

        <div class="section-header">🌐 Network &amp; Browser</div>
        <div class="dashboard-nav">
          <div class="nav-card" onclick="window.open('L2T-Network', '_blank')">
            <h3>🌐 Network Forensics</h3>
            <p>Network connection analysis from Windows registry artifacts for network activity tracking</p>
            <div class="artifacts">WiFi connections • Network drives • VPN usage • Connection timeline</div>
          </div>
          
          <div class="nav-card" onclick="window.open('L2T-Chrome-Browser-Forensics', '_blank')">
            <h3>🔍 Chrome Browser</h3>
            <p>Comprehensive Chrome browser and Google services analysis for web activity investigation</p>
            <div class="artifacts">Browsing history • Downloads • Google services • User behavior</div>
          </div>
        </div>

        <div class="section-header">📝 Event Logs</div>
        <div class="dashboard-nav">
          <div class="nav-card" onclick="window.open('L2T-WinEVTX', '_blank')">
            <h3>📊 Windows Event Logs</h3>
            <p>Windows Event Log analysis with enhanced filtering and security event focus</p>
            <div class="artifacts">Security events • System events • Application logs • Event correlation</div>
          </div>
        </div>
      </html>
    </panel>
  </row>
</form>