# PARKED (epic #86): built from the KQL contract with SYNTHETIC verification only —
# no real Velociraptor SrumECmd/RECmd output exists in the data_store yet. Per the
# owner's rule (maps are built off the ACTUAL outputs read), this does not activate
# until real output is generated (the dfir/srumecmd + dfir/recmd containers now
# exist for exactly that). Rename back to .py and re-verify against real rows.
"""Velociraptor-collected EZ outputs → MITRE CAR maps (epic #86, Phase 2).

Ports three vetted KQL views (kusto/schema/40-mitre.kql) onto the Python CAR
engine, for rows in the Velociraptor ingest wrap ``{"Artefact", "SourceFile",
"Record"}`` (ingest/prepare.py `velociraptor_wrap`):

- **CarFlow_Srum** (:210)     → ``velociraptor_srum`` / flow, action *message*
- **CarProcess_Srum** (:585)  → ``velociraptor_srum`` / process, action *create*
- **CarRegistry_Recmd** (:796)→ ``velociraptor_recmd`` / registry, actions
  *value_edit* / *key_edit*

Both SRUM tables land in one artefact key because SrumECmd emits them under the
same Velociraptor artefact family — the KQL splits the rows by which byte
counters are present (Network Usage carries BytesSent/BytesReceived; App
Resource Usage carries Foreground/BackgroundBytes*), and the variant predicates
here do the same. Rows of the *other* SRUM tables (EnergyUsage, push
notifications, app timeline) match neither predicate and stay raw — no
canonical action fits them yet.

Deliberate deviations from the stale KQL, per the authoritative model
(car_data_model.json) and the near-miss discipline (docs/CAR-Relations.md,
piiat-mem car-store.md §3):

- **registry action**: the KQL's ``"edit"`` is a pre-alignment name; the model's
  actions are add/key_edit/remove/value_edit (car-store.md: "`registry.edit` →
  `key_edit`/`value_edit`"). A RECmd batch row names a value → **value_edit**;
  a key-only row proves only the key's LastWrite → **key_edit**. A hive is a
  snapshot: add-vs-edit is indistinguishable, so ``add`` is never asserted.
- **flow byte counters ARE mapped**: the KQL comment "not CAR flow fields" is
  stale — the model's flow object lists ``in_bytes``/``out_bytes``. SRUM's
  BytesReceived/BytesSent are the same host-perspective in/out counters
  (aggregated over SRUM's ~hourly accounting window — recorded as recorded,
  the aggregation caveat is inherent to the artefact, not faked away). The
  original names also stay queryable in the kept ``Record``.
- **flow start_time is NOT mapped**: MITRE's start_time is when the flow
  *started*; SRUM's Timestamp is the accounting-window stamp of an aggregate —
  asserting it as a flow start would be a near-miss. It remains the event
  ``timestamp`` (the record's own time) and in the native Record.
- **SID → uid, not user**: the KQL coalesced Record.Sid into ``user`` (its flow
  schema pre-dated a uid column); the model's flow object has ``uid`` — the
  proper home for a SID — so user takes only username-shaped fields. SRUM's
  ``UserId`` (its internal FK, not an OS identity) stays native-only.
- **registry image_path/pid**: MITRE's registry image_path/pid identify the
  process *making the edit*. A disk-hive snapshot has no acting process; a
  Record.ImagePath on these artefacts is registry CONTENT (e.g. a service's
  binary path stored in the hive), so it stays native, never canonical. A
  Record.PID — should a collector ever emit one — is surfaced as a join
  candidate via the engine's ``owning_pid`` header, not asserted canonical.

**Verification**: NO real Velociraptor SRUM/RECmd processed evidence exists in
the data_store (verified — processed/velociraptor holds only a README), so
these maps are built from the KQL contract and verified against synthetic rows
shaped exactly as the views expect (tests/test_car_srum_recmd.py).
"""
from __future__ import annotations

import re

from ..normalize import (basename, concat, const, epoch_ts, first,  # noqa: F401
                         host_label, payload, regex1)


def _r(key):
    """``Record.<key>`` — the Velociraptor wrap nests the parser's row under
    ``Record`` (a dict; `payload` resolves dict fields, and blank-checks/strips
    exactly like the KQL tostring()+isempty discipline)."""
    return payload(key, field="Record")


# The collection dir is Collection-<host>-<timestamp> (Velociraptor offline
# collector naming; the host may itself contain dashes) — extract just the
# host from SourceFile. Ported verbatim from the KQL _vhost extract().
_VHOST = regex1("SourceFile",
                r"(?i)velociraptor/(?:Collection-)?(.+?)(?:-\d{4}-\d{2}-\d{2}[^/]*)?/")
# fqdn only when the extracted name actually IS one (contains a dot) — the
# Computer discipline used across the KQL views; else an honest null (the KQL's
# "" is its union-typing artefact, not a value).
_FQDN = regex1(_VHOST, r"^(.*\..*)$")

# Timestamp spelling varies across SrumECmd exports / Velociraptor artefact
# versions — coalesce like the KQL. epoch_ts converts an epoch, passes ISO
# strings through (SrumECmd stamps ISO-ish text).
_SRUM_TS = epoch_ts(first(_r("Timestamp"), _r("EventTime"), _r("TimeStamp")))

# App identity: ExeInfo is SrumECmd's resolved binary (often a \Device\... NT
# path, sometimes a bare AppX/package id); the alternates cover other
# collector spellings. First non-empty wins ("" falls through, matching the
# KQL's coalesce-over-tostring discipline).
_SRUM_APP = first(_r("ExeInfo"), _r("AppId"), _r("Application"), _r("App"))

# User attribution: username-shaped fields ONLY (see module docstring — the
# SID goes to uid/sid, SRUM's internal UserId FK stays native).
_SRUM_USER = first(_r("UserName"), _r("User"))


# --- variant predicates -----------------------------------------------------
# Each predicate carries the KQL view's artefact guard (`Artefact matches regex
# (?i)srum` / `(?i)recmd|registry|regexplorer`) so a foreign row fed under the
# key drops to the raw default instead of mis-mapping.

_SRUM_ART = re.compile(r"(?i)srum")
_RECMD_ART = re.compile(r"(?i)recmd|registry|regexplorer")
# Network Usage vs App Resource Usage, told apart by their byte counters —
# the KQL's isnotempty(tostring(coalesce(...))) filters. Space-separated
# spellings appear in CSV-derived exports.
_NET_KEYS = ("BytesSent", "BytesReceived", "Bytes Sent", "Bytes Received")
_APP_KEYS = ("ForegroundBytesRead", "ForegroundBytesWritten",
             "BackgroundBytesRead", "BackgroundBytesWritten")


def _record(rec) -> dict:
    r = rec.get("Record")
    return r if isinstance(r, dict) else {}


def _has_any(rec, keys) -> bool:
    """KQL isnotempty(tostring(x)) parity: 0 is present, ""/null are not."""
    r = _record(rec)
    return any(r.get(k) not in (None, "") for k in keys)


def srum_network_usage(rec) -> bool:
    return (_SRUM_ART.search(str(rec.get("Artefact") or "")) is not None
            and _has_any(rec, _NET_KEYS))


def srum_app_resource_usage(rec) -> bool:
    return (_SRUM_ART.search(str(rec.get("Artefact") or "")) is not None
            and _has_any(rec, _APP_KEYS))


def _recmd_key(rec):
    r = _record(rec)
    return r.get("KeyPath") or r.get("Key")


def _recmd_value_name(rec):
    r = _record(rec)
    return r.get("ValueName") or r.get("Value")


def recmd_value_row(rec) -> bool:
    """A row that names a value — RECmd batch output's normal shape."""
    return (_RECMD_ART.search(str(rec.get("Artefact") or "")) is not None
            and bool(_recmd_key(rec)) and bool(_recmd_value_name(rec)))


def recmd_key_row(rec) -> bool:
    """A key-level row (no value named) — proves only the key's LastWrite."""
    return (_RECMD_ART.search(str(rec.get("Artefact") or "")) is not None
            and bool(_recmd_key(rec)) and not _recmd_value_name(rec))


PREDICATES = {
    "srum_network_usage": srum_network_usage,
    "srum_app_resource_usage": srum_app_resource_usage,
    "recmd_value_row": recmd_value_row,
    "recmd_key_row": recmd_key_row,
}


# --- shared blocks ----------------------------------------------------------

# The whole native row stays queryable (the KQL views are additive — "native
# fields + CAR fields"); the wrap's constants ride along for provenance.
_VR_KEEP = ["Artefact", "SourceFile", "Record"]

# Join keys promoted out of the Record blob for the owner's capability step
# (never canonical): Sid (→ user_session/process identity, user-level so any
# later join is heuristic), AppId/ExeTimestamp (→ process image identity,
# heuristic path match), Id/UserId (SRUM-internal row/FK ids — join only
# WITHIN one SRUM export, never across artefacts).
_SRUM_NATIVE = {
    "Sid": _r("Sid"),
    "UserId": _r("UserId"),
    "AppId": _r("AppId"),
    "Id": _r("Id"),
    "ExeTimestamp": _r("ExeTimestamp"),
}

_RECMD_TS = first(_r("LastWriteTimestamp"), _r("LastWriteTime"), _r("Mtime"))
_RECMD_HIVE = first(_r("HivePath"), _r("Hive"))
_RECMD_KEY = first(_r("KeyPath"), _r("Key"))
_RECMD_VNAME = first(_r("ValueName"), _r("Value"))


def _recmd_props():
    return {
        "key": _RECMD_KEY,
        # HivePath (full on-disk path) preferred — it identifies the hive
        # precisely AND carries the user attribution (below).
        "hive": _RECMD_HIVE,
        # car-store.md §3: "registry → user: the hive's file path
        # (…\<user>\NTUSER.DAT) IS that user's — definitive by path (not a
        # join)". A collector-supplied User field wins where present.
        "user": first(_r("User"),
                      regex1(_RECMD_HIVE, r"(?i)[\\/]Users[\\/]([^\\/]+)[\\/]")),
        # MITRE registry pid = the process performing the action. No matched
        # collector emits one today; mapped faithfully to the KQL should a
        # Record.PID ever appear (it would be the actor), else an honest null.
        "pid": _r("PID"),
        "hostname": host_label(_VHOST),
        "fqdn": _FQDN,
    }


# ImagePath is registry CONTENT (a binary path stored IN the hive, e.g. a
# service's), NOT the acting process image MITRE's registry.image_path means —
# recorded natively, never canonical (near-miss rule). RECmd batch extras
# (Deleted marks recovered-deleted entries; ValueData2/3 are RECmd's decoded
# alternates) ride along where present.
_RECMD_NATIVE = {
    "ImagePath": _r("ImagePath"),
    "Deleted": _r("Deleted"),
    "ValueData2": _r("ValueData2"),
    "ValueData3": _r("ValueData3"),
    "HiveType": _r("HiveType"),
    "Description": _r("Description"),
    "Category": _r("Category"),
    "Comment": _r("Comment"),
}


MAPPINGS = {
    # ---- SrumECmd (SRUDB.dat) via Velociraptor → flow / process --------------
    "velociraptor_srum": {
        "variants": [
            # SRUM Network Usage → flow. Network activity attributed to an
            # app+user; SRUM aggregates (no 5-tuple, no direction of any single
            # connection), so the action is "message" — observed traffic,
            # not a flow start/end.
            ("srum_network_usage", {
                "object": "flow", "action": "message",
                "ts": _SRUM_TS,
                # Identity: SRUM's own per-table row id, scoped by the source
                # file (Id is an autoincrement per SRUM table). Voided (guid
                # assigned later) if a collector omits Id. ":" separators —
                # the engine reads a literal "-" as a blank, which would void
                # the concat.
                "guid": {"marker": concat(const("flow-srum-"), "SourceFile",
                                          const(":"), _r("Id"))},
                "host": host_label(_VHOST),
                "props": {
                    "image_path": _SRUM_APP,
                    "user": _SRUM_USER,
                    # model flow.uid — the OS identity of the traffic's owner;
                    # on Windows that is the SID (see module docstring).
                    "uid": _r("Sid"),
                    # model flow.in_bytes/out_bytes — host-perspective
                    # received/sent counters; SRUM's are the same, aggregated
                    # over its accounting window (recorded as recorded).
                    "in_bytes": first(_r("BytesReceived"), _r("Bytes Received")),
                    "out_bytes": first(_r("BytesSent"), _r("Bytes Sent")),
                    # start_time deliberately NOT mapped — see module docstring.
                    "hostname": host_label(_VHOST),
                    "fqdn": _FQDN,
                },
                "keep": _VR_KEEP,
                "native_extract": dict(_SRUM_NATIVE,
                                       InterfaceType=_r("InterfaceType"),
                                       ProfileName=_r("ProfileName")),
            }),
            # SRUM App Resource Usage → process. Proof the app EXECUTED,
            # attributed to a user AND a SID. "create" is the vetted view's
            # execution-evidence action (the only canonical one that asserts
            # the process existed); the timestamp is SRUM's accounting stamp,
            # not the create instant — recorded, not trusted as start time.
            ("srum_app_resource_usage", {
                "object": "process", "action": "create",
                "ts": _SRUM_TS,
                "guid": {"marker": concat(const("process-srum-"), "SourceFile",
                                          const(":"), _r("Id"))},
                "host": host_label(_VHOST),
                "props": {
                    # exe = the executable's NAME (engine convention; MITRE's
                    # process examples use the basename). basename() is a no-op
                    # on non-path AppX ids, so nothing is mangled.
                    "exe": basename(_SRUM_APP),
                    "image_path": _SRUM_APP,
                    "user": _SRUM_USER,
                    "sid": _r("Sid"),
                    # pid/ppid/command_line/hashes: SRUM has none — honest nulls.
                    "hostname": host_label(_VHOST),
                    "fqdn": _FQDN,
                },
                "keep": _VR_KEEP,
                "native_extract": _SRUM_NATIVE,
            }),
        ],
        # EnergyUsage / push-notification / timeline SRUM rows: no canonical
        # object/action fits — they stay raw rather than guessed at.
        "default": None,
    },
    # ---- RECmd batch (disk hive snapshot) via Velociraptor → registry --------
    "velociraptor_recmd": {
        "variants": [
            # A hive records a key's LAST write only, so a snapshot can prove
            # an edit but never distinguish add-vs-edit — value rows are
            # value_edit (the authoritative replacement for the KQL's stale
            # "edit"), never "add".
            ("recmd_value_row", {
                "object": "registry", "action": "value_edit",
                "ts": epoch_ts(_RECMD_TS),
                # Identity per car-store.md §3: (hive, key, value, last_write).
                # Voided (assigned later) when a component is absent.
                "guid": {"marker": concat(const("registry-"), _RECMD_HIVE,
                                          const(":"), _RECMD_KEY, const(":"),
                                          _RECMD_VNAME, const(":"), _RECMD_TS)},
                "host": host_label(_VHOST),
                "props": dict(_recmd_props(),
                              value=_RECMD_VNAME,
                              data=first(_r("ValueData"), _r("Data")),
                              type=first(_r("ValueType"), _r("Type"))),
                # A PID, if a collector ever emits one, is a candidate ACTOR
                # join key — surfaced on the engine header for the later
                # create-time-window join, never fabricated here.
                "owning_pid": _r("PID"),
                "keep": _VR_KEEP,
                "native_extract": _RECMD_NATIVE,
            }),
            # Key-level row: only the key and its LastWrite are proven —
            # key_edit, and no value/data/type asserted (whatever else the
            # row carries stays in the native Record).
            ("recmd_key_row", {
                "object": "registry", "action": "key_edit",
                "ts": epoch_ts(_RECMD_TS),
                "guid": {"marker": concat(const("registry-"), _RECMD_HIVE,
                                          const(":"), _RECMD_KEY, const(":"),
                                          _RECMD_TS)},
                "host": host_label(_VHOST),
                "props": _recmd_props(),
                "owning_pid": _r("PID"),
                "keep": _VR_KEEP,
                "native_extract": _RECMD_NATIVE,
            }),
        ],
        # No key path at all: nothing provable — the row stays raw.
        "default": None,
    },
}
