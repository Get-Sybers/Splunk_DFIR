<form version="1.1" theme="dark">
  <label>BSL - Host-Triage</label>
  <!-- Base search to populate tokens -->
  <search id="base_info_search" depends="$host_ip_token$">
    <query>
      index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$ OR id_resp_h=$host_ip_token$
      | eval ip_address=if(id_orig_h=$host_ip_token$, id_orig_h, id_resp_h)
      | stats dc(id_orig_h) as orig_count, dc(id_resp_h) as resp_count by ip_address
      | head 1
    </query>
    <earliest>$timetoken.earliest$</earliest>
    <latest>$timetoken.latest$</latest>
    <done>
      <condition match="$job.resultCount$ &gt; 0">
        <set token="host_info_found">true</set>
      </condition>
    </done>
  </search>
  <fieldset submitButton="false">
    <input type="time" token="timetoken">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="host_ip_token">
      <label>Host IP</label>
      <choice value="*">All</choice>
      <fieldForLabel>ip_address</fieldForLabel>
      <fieldForValue>ip_address</fieldForValue>
      <search>
        <query>| inputlookup BSL_FQDN_IP.csv
| table ip_address, FQDN
| search FQDN="$host_ip_token$"
| sort ip_address</query>
        <earliest>$timetoken.earliest$</earliest>
        <latest>$timetoken.latest$</latest>
      </search>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
    <input type="dropdown" token="host_ip_token">
      <label>FQDN</label>
      <choice value="*">All</choice>
      <fieldForLabel>FQDN</fieldForLabel>
      <fieldForValue>ip_address</fieldForValue>
      <search>
        <query>| inputlookup BSL_FQDN_IP.csv
| table ip_address, FQDN
| search ip_address="$host_ip_token$"
| sort FQDN</query>
        <earliest>$timetoken.earliest$</earliest>
        <latest>$timetoken.latest$</latest>
      </search>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
  </fieldset>
  <row>
    <panel depends="$host_ip_token$">
      <html>
        <div style="text-align: center; padding: 10px;">
          <span>
            <strong>Analyzing Host:</strong> $host_ip_token$ ($host_ip_token$)</span>
          <span style="margin-left: 20px;">
            <strong>Data Source:</strong> Zeek Network Logs</span>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <viz type="sankey_diagram_app.sankey_diagram">
        <search>
          <query>index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$
| stats count by id_orig_h, id_resp_p
| sort id_orig_h, id_resp_p</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </viz>
    </panel>
    <panel>
      <viz type="sankey_diagram_app.sankey_diagram">
        <search>
          <query>index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$
| stats count by id_resp_p, service
| sort id_resp_p, service</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </viz>
    </panel>
    <panel>
      <viz type="sankey_diagram_app.sankey_diagram">
        <search>
          <query>index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$
| stats count by id_resp_p, id_resp_h
| sort id_resp_p, id_resp_h</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </viz>
    </panel>
  </row>
  <row>
    <panel>
      <title>Top Destination IPs</title>
      <chart>
        <search>
          <query>index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$ 
| stats count by id_resp_h
| sort -count
| head 10</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Top Destination Ports</title>
      <chart>
        <search>
          <query>index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$ 
| stats count by id_resp_p
| sort -count
| head 10</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Connection Protocol Distribution</title>
      <chart>
        <search>
          <query>index=network sourcetype=zeek:conn id_orig_h=$host_ip_token$ 
| stats count by proto
| sort -count</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>DNS Queries Summary</title>
      <table>
        <search>
          <query>index=network sourcetype=zeek:dns id_orig_h=$host_ip_token$
| stats count by query, qtype_name
| sort -count
| head 20
| rename query as "Domain Queried", qtype_name as "Query Type", count as "Count"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="refresh.display">progressbar</option>
        <option name="drilldown">none</option>
        <option name="count">10</option>
      </table>
    </panel>
    <panel>
      <title>HTTP Activity Summary</title>
      <table>
        <search>
          <query>index=network sourcetype=zeek:http id_orig_h=$host_ip_token$
| stats count by id_orig_h, method, status_code
| sort -count
| head 20
| rename id_orig_h AS "Orig IP", method as "Method", status_code as "Status", count as "Count"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
    <panel>
      <title>SSL/TLS Certificate Analysis</title>
      <table>
        <search>
          <query>index=network sourcetype=zeek:ssl id_orig_h=$host_ip_token$
| stats count by server_name, version
| sort -count
| head 20
| rename server_name as "Server Name", version as "SSL Version", count as "Count"</query>
          <earliest>$timetoken.earliest$</earliest>
          <latest>$timetoken.latest$</latest>
        </search>
        <option name="refresh.display">progressbar</option>
        <option name="drilldown">none</option>
        <option name="count">10</option>
      </table>
    </panel>
  </row>
</form>