{
  "modelName": "CAR-User_Session",
  "displayName": "CAR User Session",
  "description": "A user session represents a period of time where a user is logged into a particular asset. The session captures the details of the user's identity and the asset they were logged into.",
  "editable": false,
  "objects": [
    {
      "objectName": "CARUserSession",
      "displayName": "CAR User Session",
      "parentName": "BaseEvent",
      "fields": [
        {
          "fieldName": "dest_ip",
          "displayName": "dest_ip",
          "type": "string",
          "comment": {
            "description": "Destination IP address for the session.",
            "example": "10.0.0.54"
          }
        },
        {
          "fieldName": "dest_port",
          "displayName": "dest_port",
          "type": "number",
          "comment": {
            "description": "Destination port for the session.",
            "example": 3389
          }
        },
        {
          "fieldName": "hostname",
          "displayName": "hostname",
          "type": "string",
          "comment": {
            "description": "Host on which the session is taking place.",
            "example": "HOST1"
          }
        },
        {
          "fieldName": "logon_id",
          "displayName": "logon_id",
          "type": "string",
          "comment": {
            "description": "Unique identifier for the specific logon session.",
            "example": "0x34653"
          }
        },
        {
          "fieldName": "src_ip",
          "displayName": "src_ip",
          "type": "string",
          "comment": {
            "description": "Source IP address for the session.",
            "example": "192.168.1.5"
          }
        },
        {
          "fieldName": "src_port",
          "displayName": "src_port",
          "type": "number",
          "comment": {
            "description": "Source port for the session.",
            "example": 54321
          }
        },
        {
          "fieldName": "user",
          "displayName": "user",
          "type": "string",
          "comment": {
            "description": "User involved in the session.",
            "example": "HOST1\\LOCALUSER"
          }
        }
      ],
      "calculations": [
        {
          "calculationID": "UserSession_Action_Interactive",
          "calculationType": "Eval",
          "expression": "if(isnull(interactive) OR interactive==\"\", \"unknown\", interactive)",
          "outputFields": [
            {
              "fieldName": "interactive",
              "displayName": "interactive",
              "type": "string",
              "comment": {
                "description": "User directly interacted with the system console."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Local",
          "calculationType": "Eval",
          "expression": "if(isnull(local) OR local==\"\", \"unknown\", local)",
          "outputFields": [
            {
              "fieldName": "local",
              "displayName": "local",
              "type": "string",
              "comment": {
                "description": "Local logon session."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Lock",
          "calculationType": "Eval",
          "expression": "if(isnull(lock) OR lock==\"\", \"unknown\", lock)",
          "outputFields": [
            {
              "fieldName": "lock",
              "displayName": "lock",
              "type": "string",
              "comment": {
                "description": "User locked their session."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Login",
          "calculationType": "Eval",
          "expression": "if(isnull(login) OR login==\"\", \"unknown\", login)",
          "outputFields": [
            {
              "fieldName": "login",
              "displayName": "login",
              "type": "string",
              "comment": {
                "description": "User logged into the system."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Logout",
          "calculationType": "Eval",
          "expression": "if(isnull(logout) OR logout==\"\", \"unknown\", logout)",
          "outputFields": [
            {
              "fieldName": "logout",
              "displayName": "logout",
              "type": "string",
              "comment": {
                "description": "User logged out of the system."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_RDP",
          "calculationType": "Eval",
          "expression": "if(isnull(rdp) OR rdp==\"\", \"unknown\", rdp)",
          "outputFields": [
            {
              "fieldName": "rdp",
              "displayName": "rdp",
              "type": "string",
              "comment": {
                "description": "Remote Desktop Protocol session."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Reconnect",
          "calculationType": "Eval",
          "expression": "if(isnull(reconnect) OR reconnect==\"\", \"unknown\", reconnect)",
          "outputFields": [
            {
              "fieldName": "reconnect",
              "displayName": "reconnect",
              "type": "string",
              "comment": {
                "description": "User reconnected to an existing session."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Remote",
          "calculationType": "Eval",
          "expression": "if(isnull(remote) OR remote==\"\", \"unknown\", remote)",
          "outputFields": [
            {
              "fieldName": "remote",
              "displayName": "remote",
              "type": "string",
              "comment": {
                "description": "Remote logon session."
              }
            }
          ]
        },
        {
          "calculationID": "UserSession_Action_Unlock",
          "calculationType": "Eval",
          "expression": "if(isnull(unlock) OR unlock==\"\", \"unknown\", unlock)",
          "outputFields": [
            {
              "fieldName": "unlock",
              "displayName": "unlock",
              "type": "string",
              "comment": {
                "description": "User unlocked their session."
              }
            }
          ]
        }
      ],
      "constraints": []
    }
  ]
}