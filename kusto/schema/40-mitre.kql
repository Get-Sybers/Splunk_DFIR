//=============================================================================
// Views over the materialised tables
//=============================================================================
.create-or-alter function
with (docstring = "Every materialised CAR event across all 13 objects, common header only — one CAR timeline", folder = "CAR/materialized")
Car() {
    union isfuzzy=true
        car_authentication, car_driver, car_email, car_file, car_flow, car_http,
        car_module, car_process, car_registry, car_service, car_socket,
        car_thread, car_user_session
    | project car_object, timestamp = todatetime(timestamp), car_action, guid,
              owning_guid, link_confidence, source_artefact, source_host, native
    | order by timestamp asc
}

.create-or-alter function
with (docstring = "Row counts per materialised CAR object table", folder = "CAR/materialized")
CarObjects() {
    Car()
    | summarize Events = count() by car_object
    | order by Events desc
}

